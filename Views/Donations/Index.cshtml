@{
    ViewData["Title"] = "Donaciones y Apoyo";
    Layout = "_Layout";
}

<div class="max-w-4xl mx-auto py-8 px-4">
    <div class="text-center mb-10">
        <div class="w-16 h-16 bg-[#C5A059]/20 text-[#C5A059] rounded-2xl flex items-center justify-center mx-auto mb-4 text-3xl shadow-inner">
            <i class="fa-solid fa-hand-holding-dollar"></i>
        </div>
        <h1 class="text-3xl font-extrabold text-[#1B365D]">Apoya Nuestra Misión</h1>
        <p class="text-gray-600 text-sm mt-2 max-w-lg mx-auto">
            "Cada uno dé como propuso en su corazón: no con tristeza, ni por necesidad, porque Dios ama al dador alegre." (2 Corintios 9:7)
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-700 rounded-xl text-sm font-semibold flex items-center space-x-2">
            <i class="fa-solid fa-circle-check text-lg"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- OPCIÓN 1: PAYPAL -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 flex flex-col justify-between hover:shadow-md transition-all">
            <div>
                <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-xl mb-4 font-bold">
                    <i class="fa-brands fa-paypal"></i>
                </div>
                <h3 class="font-bold text-[#1B365D] text-lg mb-1">PayPal</h3>
                <p class="text-xs text-gray-500 mb-6">Realiza una donación internacional segura utilizando tu cuenta de PayPal o saldo disponible.</p>
            </div>
            <div>
                <!-- Enlace o botón hacia tu enlace de PayPal.me o pasarela -->
                <a href="https://paypal.me/TuCuentaCompass" target="_blank" onclick="registrarDonacionExterna('PayPal')" class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 rounded-xl text-sm transition-all shadow">
                    Donar con PayPal
                </a>
            </div>
        </div>

        <!-- OPCIÓN 2: TARJETA DE CRÉDITO / DÉBITO -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 flex flex-col justify-between hover:shadow-md transition-all">
            <div>
                <div class="w-12 h-12 bg-amber-50 text-[#C5A059] rounded-xl flex items-center justify-center text-xl mb-4 font-bold">
                    <i class="fa-solid fa-credit-card"></i>
                </div>
                <h3 class="font-bold text-[#1B365D] text-lg mb-1">Tarjeta de Crédito</h3>
                <p class="text-xs text-gray-500 mb-6">Aporte mediante pasarela segura con tarjeta Visa, Mastercard o American Express.</p>
            </div>
            <div>
                <button onclick="abrirModalTarjeta()" class="w-full bg-[#1B365D] hover:bg-opacity-90 text-white font-bold py-2.5 rounded-xl text-sm transition-all shadow">
                    Donar con Tarjeta
                </button>
            </div>
        </div>

        <!-- OPCIÓN 3: YAPPY (Muy común en Panamá / Centroamérica) -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 flex flex-col justify-between hover:shadow-md transition-all">
            <div>
                <div class="w-12 h-12 bg-red-50 text-red-600 rounded-xl flex items-center justify-center text-xl mb-4 font-bold">
                    <i class="fa-solid fa-mobile-screen-button"></i>
                </div>
                <h3 class="font-bold text-[#1B365D] text-lg mb-1">Yappy</h3>
                <p class="text-xs text-gray-500 mb-6">Escanea el código QR o realiza tu aporte directo al directorio oficial de la fundación.</p>
            </div>
            <div>
                <button onclick="abrirModalYappy()" class="w-full bg-[#C5A059] hover:bg-[#A88647] text-[#1B365D] font-bold py-2.5 rounded-xl text-sm transition-all shadow">
                    Donar por Yappy
                </button>
            </div>
        </div>

    </div>
</div>

<!-- Modal Genérico para registrar el aporte -->
<div id="modalDonacion" class="fixed inset-0 z-50 hidden bg-black bg-opacity-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6">
        <h3 id="modalTitulo" class="text-xl font-bold text-[#1B365D] mb-3">Registrar Donación</h3>
        <form asp-action="RegisterDonation" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="paymentMethodInput" name="paymentMethod" value="Tarjeta" />
            <div>
                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Monto a Donar (USD)</label>
                <input type="number" step="0.01" name="amount" required placeholder="25.00" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none" />
            </div>

            <div id="yappyInfo" class="hidden p-3 bg-gray-50 rounded-xl text-xs text-gray-600 border border-gray-200">
                <p class="font-bold text-[#1B365D] mb-1">📱 Directorio Yappy:</p>
                <p>Busca en tu aplicación de Banco General el directorio: <strong>MayordomiaFinanciera</strong> o escanea nuestro QR institucional.</p>
            </div>

            <div class="flex justify-end space-x-3 pt-3 border-t border-gray-100">
                <button type="button" onclick="cerrarModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-xl text-sm font-semibold">Cancelar</button>
                <button type="submit" class="px-5 py-2 bg-[#1B365D] text-white rounded-xl text-sm font-semibold">Confirmar Aporte</button>
            </div>
        </form>
    </div>
</div>

<script>
    function abrirModalTarjeta() {
        document.getElementById('paymentMethodInput').value = 'Tarjeta';
        document.getElementById('modalTitulo').innerText = 'Donación con Tarjeta de Crédito';
        document.getElementById('yappyInfo').classList.add('hidden');
        document.getElementById('modalDonacion').classList.remove('hidden');
    }

    function abrirModalYappy() {
        document.getElementById('paymentMethodInput').value = 'Yappy';
        document.getElementById('modalTitulo').innerText = 'Donación mediante Yappy';
        document.getElementById('yappyInfo').classList.remove('hidden');
        document.getElementById('modalDonacion').classList.remove('hidden');
    }

    function cerrarModal() {
        document.getElementById('modalDonacion').classList.add('hidden');
    }

    function registrarDonacionExterna(metodo) {
        // Opcional: puedes hacer un llamado AJAX si deseas registrar el clic de PayPal de inmediato
    }
</script>