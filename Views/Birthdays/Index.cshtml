@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Informe de Cumpleaños";
    Layout = "_Layout";
    int currentMonth = DateTime.Now.Month;
}

<div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h1 class="text-3xl font-extrabold text-[#1B365D]">Informe de Cumpleaños</h1>
        <p class="text-gray-500 text-sm mt-1">Listado completo y filtrado de cumpleaños de alumnos, profesores y administradores.</p>
    </div>
    <div class="bg-[#00A8CC]/20 text-[#A88647] px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider">
        <i class="fa-solid fa-cake-candles mr-1.5"></i> Mes Actual: @DateTime.Now.ToString("MMMM").ToUpper()
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="p-6 border-b border-gray-100 bg-gray-50">
        <h3 class="font-bold text-[#1B365D] text-base">Agenda de Cumpleaños</h3>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="text-[#1B365D] text-xs font-bold uppercase tracking-wider border-b border-gray-200 bg-gray-50">
                    <th class="p-4">Usuario</th>
                    <th class="p-4">Rol</th>
                    <th class="p-4">País</th>
                    <th class="p-4">Fecha de Cumpleaños</th>
                    <th class="p-4">Grupo Asignado</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm">
                @if (Model == null || Model.Rows.Count == 0)
                {
                    <tr><td colspan="5" class="p-6 text-center text-gray-500">No hay usuarios registrados.</td></tr>
                }
                else
                {
                    foreach (DataRow row in Model.Rows)
                    {
                        if (row["BirthDate"] == DBNull.Value) continue;
                        DateTime bDate = Convert.ToDateTime(row["BirthDate"]);
                        bool isThisMonth = bDate.Month == currentMonth;

                        <tr class="hover:bg-gray-50 @(isThisMonth ? "bg-amber-50/40" : "")">
                            <td class="p-4 font-semibold text-gray-800">@row["Name"]</td>
                            <td class="p-4"><span class="px-2.5 py-1 rounded-full text-xs font-bold uppercase @(row["Role"].ToString() == "admin" ? "bg-purple-100 text-purple-750" : "bg-green-100 text-green-700")">@row["Role"]</span></td>
                            <td class="p-4 text-gray-600 text-xs"><i class="fa-solid fa-earth-americas mr-1 text-[#00A8CC]"></i>@row["Country"]</td>
                            <td class="p-4 font-medium text-[#1B365D]">@bDate.ToString("dd de MMMM")</td>
                            <td class="p-4 text-gray-600 text-xs">@(row["GroupName"] != DBNull.Value ? row["GroupName"] : "Ninguno")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>