@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Muro de Comunidad";
    Layout = "_Layout";
}

<div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h1 class="text-3xl font-extrabold text-[#1B365D]">Muro de Comunidad y Oración</h1>
        <p class="text-gray-500 text-sm mt-1">Comparte tus peticiones de oración, testimonios o reflexiones bíblicas con la hermandad.</p>
    </div>
    <div class="flex items-center space-x-3">
        <a href="@Url.Action("ExportCsv", "Community")" class="bg-[#1B365D] hover:bg-[#152948] text-white px-4 py-2.5 rounded-lg text-sm font-bold transition-all shadow-md flex items-center space-x-2">
            <i class="fa-solid fa-file-arrow-down"></i>
            <span>Exportar CSV</span>
        </a>
        <button onclick="openPostModal()" class="bg-[#1B365D] text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-opacity-90 transition-all shadow flex items-center space-x-2">
            <i class="fa-solid fa-pen-to-square"></i><span>Nueva Publicación</span>
        </button>
    </div>
</div>

<!-- Formulario para Nueva Publicación -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
    <h3 class="text-lg font-bold text-[#1B365D] mb-4 flex items-center"><i class="fa-solid fa-pen-to-square text-[#C5A059] mr-2"></i> Nueva Publicación</h3>
    <form asp-action="CreatePost" method="post" class="space-y-4">
        <!-- Reemplaza el UserId con el ID real del usuario conectado o envíalo por claims -->
        <input type="hidden" name="userId" value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? Guid.NewGuid().ToString()" />
        <input type="hidden" name="name" value="@User.Identity?.Name" />

        <div>
            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Categoría</label>
            <select name="category" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none bg-white">
                <option value="oracion">🙏 Petición de Oración</option>
                <option value="testimonio">✨ Testimonio de Bendición</option>
                <option value="reflexion">📖 Reflexión / Mayordomía</option>
            </select>
        </div>
        <div>
            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Contenido / Mensaje</label>
            <textarea name="content" rows="3" required placeholder="Escribe tu petición de oración o comentario aquí..." class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none"></textarea>
        </div>
        <div class="flex justify-end">
            <button type="submit" class="px-5 py-2.5 bg-[#1B365D] text-white rounded-lg text-sm font-semibold hover:bg-opacity-90 transition-all shadow">Publicar en el Muro</button>
        </div>
    </form>
</div>

<!-- Listado de Publicaciones -->
<div class="space-y-4">
    @if (Model == null || Model.Rows.Count == 0)
    {
        <div class="bg-white p-12 rounded-xl text-center border border-gray-200 text-gray-500">
            <i class="fa-solid fa-comments text-4xl text-gray-300 mb-3"></i>
            <p class="text-base font-medium">Aún no hay publicaciones en el muro. ¡Sé el primero en compartir algo!</p>
        </div>
    }
    else
    {
        @foreach (DataRow row in Model.Rows)
        {
            string category = row["Category"].ToString()!;
            string badgeColor = "bg-amber-100 text-amber-800";
            string icon = "fa-hands-praying";
            string catLabel = "Petición de Oración";

            if (category == "testimonio") { badgeColor = "bg-green-100 text-green-800"; icon = "fa-heart"; catLabel = "Testimonio"; }
            else if (category == "reflexion") { badgeColor = "bg-blue-100 text-blue-800"; icon = "fa-book-open"; catLabel = "Reflexión"; }

            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 transition-all hover:shadow-md">
                <div class="flex justify-between items-start mb-3">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-full bg-[#1B365D]/10 text-[#1B365D] font-bold flex items-center justify-center text-sm">
                            @row["Name"].ToString()!.Substring(0, 1).ToUpper()
                        </div>
                        <div>
                            <h4 class="font-bold text-[#1B365D] text-sm">@row["Name"]</h4>
                            <span class="text-[11px] text-gray-400"><i class="fa-regular fa-clock mr-1"></i>@Convert.ToDateTime(row["CreatedAt"]).ToString("dd de MMMM yyyy, HH:mm")</span>
                        </div>
                    </div>
                    <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider @badgeColor">
                        <i class="fa-solid @icon mr-1"></i> @catLabel
                    </span>
                </div>
                <p class="text-gray-700 text-sm whitespace-pre-line leading-relaxed pl-1">@row["Content"]</p>
            </div>
        }
    }
</div>