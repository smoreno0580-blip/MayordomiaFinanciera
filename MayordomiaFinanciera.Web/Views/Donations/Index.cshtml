@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Apóyanos - Donaciones";
    Layout = "_Layout"; // <-- Esto asegura que aparezca la barra de navegación superior
    bool isFallback = ViewBag.IsFallbackToGeneral != null && (bool)ViewBag.IsFallbackToGeneral;
}

<div class="max-w-4xl mx-auto px-4 py-12">
    <div class="text-center mb-10">
        <h1 class="text-3xl font-extrabold text-[#1B365D]">Apoya Nuestra Misión</h1>
        <p class="text-gray-600 mt-2">Tu generosidad nos permite llevar formación y recursos de mayordomía y finanzas a más personas.</p>
    </div>

    <!-- Alerta dinámica si se está mostrando el respaldo general del ministerio -->
    @if (isFallback)
    {
        <div class="mb-8 p-4 bg-blue-50 border-l-4 border-[#00A8CC] text-blue-900 rounded-r-xl text-xs shadow-sm flex items-center space-x-3">
            <i class="fa-solid fa-circle-info text-lg text-[#00A8CC]"></i>
            <div>
                <span class="font-bold block">Aviso ministerial:</span>
                Tu congregación local aún no ha configurado cuentas bancarias propias. Mostramos temporalmente los canales oficiales del ministerio general.
            </div>
        </div>
    }

    <!-- Si es Administrador, Pastor o Profesor, mostrar acceso directo inteligente para gestionar métodos -->
    @if (User.IsInRole("admin") || User.IsInRole("ADMIN") || User.IsInRole("PASTOR") || User.IsInRole("pastor") || User.IsInRole("teacher") || User.IsInRole("TEACHER"))
    {
        // Detectar si el usuario tiene una iglesia asociada en sus claims
        var churchClaim = User.FindFirst("ChurchId")?.Value ?? User.FindFirst("church_id")?.Value;
        bool hasChurchAssigned = !string.IsNullOrEmpty(churchClaim) && churchClaim != Guid.Empty.ToString();

        <div class="mb-6 text-right">
            @if (hasChurchAssigned)
            {
                <!-- Si pertenece a una iglesia, va directo a su configuración eclesial -->
                <a href="@Url.Action("PaymentSettings", "ChurchAdmin")" class="px-4 py-2 bg-amber-600 text-white rounded-lg text-sm font-semibold shadow hover:bg-amber-700 transition">
                    <i class="fa-solid fa-church mr-1"></i> Configurar Cuentas de Mi Iglesia
                </a>
            }
            else
            {
                <!-- Si es administrador general del ministerio, va a la gestión global -->
                <a href="@Url.Action("Manage", "Donations")" class="px-4 py-2 bg-amber-600 text-white rounded-lg text-sm font-semibold shadow hover:bg-amber-700 transition">
                    <i class="fa-solid fa-gear mr-1"></i> Administrar Métodos Globales
                </a>
            }
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @if (Model != null && Model.Rows.Count > 0)
        {
            @foreach (DataRow row in Model.Rows)
            {
                // Manejo de seguridad por si la columna payment_method no existe o es nula
                string method = row.Table.Columns.Contains("payment_method") && row["payment_method"] != DBNull.Value
                ? row["payment_method"].ToString()!
                : "other";

                string iconClass = method switch
                {
                    "bank" => "fa-building-columns text-blue-600",
                    "paypal" => "fa-brands fa-paypal text-sky-600",
                    "yappy" => "fa-mobile-screen-button text-amber-500",
                    "card" => "fa-credit-card text-emerald-600",
                    _ => "fa-circle-dollar-to-slot text-[#00A8CC]"
                };

                <div class="bg-white p-6 rounded-xl shadow-md border border-gray-100 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center space-x-3 mb-4">
                            <div class="w-10 h-10 rounded-lg bg-gray-50 flex items-center justify-center text-xl shadow-inner">
                                <i class="fa-solid @iconClass"></i>
                            </div>
                            <h3 class="text-lg font-bold text-[#1B365D]">@row["title"]</h3>
                        </div>
                        <p class="text-sm text-gray-600 whitespace-pre-line bg-gray-50 p-4 rounded-lg font-mono">
                            @row["details"]
                        </p>
                    </div>

                    @if (method == "paypal")
                    {
                        <div class="mt-6">
                            <a href="https://paypal.com" target="_blank" class="block w-full text-center py-2.5 bg-sky-600 text-white rounded-lg font-semibold text-sm hover:bg-sky-700 transition">Donar con PayPal</a>
                        </div>
                    }
                    else if (method == "card")
                    {
                        <div class="mt-6">
                            <button onclick="alert('Pasarela de pagos con tarjeta próximamente habilitada.');" class="w-full py-2.5 bg-emerald-600 text-white rounded-lg font-semibold text-sm hover:bg-emerald-700 transition">Donar con Tarjeta</button>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="col-span-2 text-center py-12 bg-white rounded-xl shadow-sm border border-gray-100 p-8">
                <p class="text-gray-500 mb-4">No hay métodos de donación configurados actualmente para tu congregación.</p>
                @if (User.IsInRole("admin") || User.IsInRole("ADMIN") || User.IsInRole("PASTOR") || User.IsInRole("teacher") || User.IsInRole("TEACHER"))
                {
                    var churchClaimEmpty = User.FindFirst("ChurchId")?.Value ?? User.FindFirst("church_id")?.Value;
                    bool hasChurchEmpty = !string.IsNullOrEmpty(churchClaimEmpty) && churchClaimEmpty != Guid.Empty.ToString();

                    if (hasChurchEmpty)
                    {
                        <a href="@Url.Action("PaymentSettings", "ChurchAdmin")" class="inline-block px-5 py-2.5 bg-[#1B365D] text-white rounded-lg text-sm font-semibold shadow">Configurar Cuentas de Mi Iglesia</a>
                    }
                    else
                    {
                        <a href="@Url.Action("Manage", "Donations")" class="inline-block px-5 py-2.5 bg-[#1B365D] text-white rounded-lg text-sm font-semibold shadow">Configurar Métodos Ahora</a>
                    }
                }
            </div>
        }
    </div>
</div>