@model MayordomiaFinanciera.Web.Models.Church.RegisterChurchViewModel
@{
    ViewData["Title"] = "Registro y Gestión de Iglesias SaaS";
    Layout = "_Layout";
    var churches = ViewBag.Churches as IEnumerable<MayordomiaFinanciera.Web.Models.Church.ChurchDto> ?? new List<MayordomiaFinanciera.Web.Models.Church.ChurchDto>();
}

<div class="max-w-5xl mx-auto space-y-8 py-4">

    <!-- Encabezado -->
    <div class="text-center space-y-2">
        <span class="text-xs font-bold uppercase text-[#00A8CC] tracking-widest">Plataforma Ministerial SaaS</span>
        <h1 class="text-3xl font-black text-[#1B365D]">Registrar Nueva Iglesia o Ministerio</h1>
        <p class="text-sm text-gray-600 max-w-xl mx-auto">
            Configura el perfil eclesial, asigna la suscripción y genera las credenciales iniciales para el pastor.
        </p>
    </div>

    <!-- Alertas de Éxito o Mensajes del Servidor -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-50 border-l-4 border-emerald-500 p-4 rounded-xl text-emerald-800 text-xs font-bold flex items-center justify-between shadow-sm">
            <div class="flex items-center">
                <i class="fa-solid fa-[#00A8CC] fa-circle-check mr-2 text-base text-emerald-600"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        </div>
    }

    <!-- Alerta de Errores de Validación del Servidor -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-xl text-red-700 text-xs space-y-1">
            <div class="font-bold flex items-center">
                <i class="fa-solid fa-triangle-exclamation mr-2"></i> No se pudo procesar el registro. Por favor verifica:
            </div>
            @Html.ValidationSummary(false, "", new { @class = "list-disc pl-5" })
        </div>
    }

    <!-- Formulario Principal -->
    <form asp-controller="SaaSChurch" asp-action="Register" method="post" class="space-y-8">
        @Html.AntiForgeryToken()

        <!-- Selección de Planes de Suscripción -->
        <div class="space-y-4">
            <h2 class="text-base font-bold text-[#1B365D] flex items-center">
                <i class="fa-solid fa-tags text-[#00A8CC] mr-2"></i> 1. Selecciona el Plan de Suscripción
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Plan Semilla -->
                <label class="relative bg-white p-5 rounded-2xl border-2 border-gray-200 hover:border-[#00A8CC] cursor-pointer transition shadow-sm flex flex-col justify-between">
                    <input type="radio" asp-for="SubscriptionPlan" value="SEED" class="sr-only peer" checked>
                    <div class="peer-checked:border-[#00A8CC] peer-checked:ring-2 peer-checked:ring-[#00A8CC] absolute inset-0 rounded-2xl pointer-events-none"></div>
                    <div>
                        <span class="text-xs font-extrabold text-[#00A8CC] uppercase block">Plan Semilla</span>
                        <h3 class="text-xl font-black text-[#1B365D] mt-1">$15 <span class="text-xs font-normal text-gray-500">/ mes</span></h3>
                        <p class="text-xs text-gray-500 mt-2">Ideal para iglesias pequeñas o misiones emergentes.</p>
                        <ul class="text-xs text-gray-600 space-y-1.5 mt-4">
                            <li><i class="fa-solid fa-check text-emerald-500 mr-1.5"></i> Hasta 50 miembros</li>
                            <li><i class="fa-solid fa-check text-emerald-500 mr-1.5"></i> Herramientas completas</li>
                        </ul>
                    </div>
                </label>

                <!-- Plan Ministerial -->
                <label class="relative bg-white p-5 rounded-2xl border-2 border-gray-200 hover:border-[#00A8CC] cursor-pointer transition shadow-sm flex flex-col justify-between">
                    <input type="radio" asp-for="SubscriptionPlan" value="MINISTERIAL" class="sr-only peer">
                    <div class="peer-checked:border-[#00A8CC] peer-checked:ring-2 peer-checked:ring-[#00A8CC] absolute inset-0 rounded-2xl pointer-events-none"></div>
                    <span class="absolute -top-3 right-4 bg-[#00A8CC] text-white text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full">Recomendado</span>
                    <div>
                        <span class="text-xs font-extrabold text-[#00A8CC] uppercase block">Plan Ministerial</span>
                        <h3 class="text-xl font-black text-[#1B365D] mt-1">$30 <span class="text-xs font-normal text-gray-500">/ mes</span></h3>
                        <p class="text-xs text-gray-500 mt-2">Para congregaciones medianas en crecimiento.</p>
                        <ul class="text-xs text-gray-600 space-y-1.5 mt-4">
                            <li><i class="fa-solid fa-check text-emerald-500 mr-1.5"></i> Hasta 200 miembros</li>
                            <li><i class="fa-solid fa-check text-emerald-500 mr-1.5"></i> Reportes ejecutivos</li>
                        </ul>
                    </div>
                </label>

                <!-- Plan Catedral -->
                <label class="relative bg-white p-5 rounded-2xl border-2 border-gray-200 hover:border-[#00A8CC] cursor-pointer transition shadow-sm flex flex-col justify-between">
                    <input type="radio" asp-for="SubscriptionPlan" value="CATHEDRAL" class="sr-only peer">
                    <div class="peer-checked:border-[#00A8CC] peer-checked:ring-2 peer-checked:ring-[#00A8CC] absolute inset-0 rounded-2xl pointer-events-none"></div>
                    <div>
                        <span class="text-xs font-extrabold text-[#00A8CC] uppercase block">Plan Catedral</span>
                        <h3 class="text-xl font-black text-[#1B365D] mt-1">$50 <span class="text-xs font-normal text-gray-500">/ mes</span></h3>
                        <p class="text-xs text-gray-500 mt-2">Para megaiglesias o múltiples sedes.</p>
                        <ul class="text-xs text-gray-600 space-y-1.5 mt-4">
                            <li><i class="fa-solid fa-check text-emerald-500 mr-1.5"></i> Hasta 1,000 miembros</li>
                            <li><i class="fa-solid fa-check text-emerald-500 mr-1.5"></i> Soporte prioritario</li>
                        </ul>
                    </div>
                </label>
            </div>
        </div>

        <!-- Datos de la Iglesia y del Administrador -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200 space-y-4">
            <h2 class="text-base font-bold text-[#1B365D] border-b border-gray-100 pb-2">
                <i class="fa-solid fa-church text-[#00A8CC] mr-2"></i> 2. Datos de la Iglesia y del Pastor
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div>
                    <label class="block font-bold text-gray-700 uppercase mb-1">Nombre de la Iglesia / Ministerio</label>
                    <input type="text" asp-for="Name" required placeholder="Ej: Ministerio de Finanzas" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D]">
                    <span asp-validation-for="Name" class="text-red-500 text-[10px]"></span>
                </div>

                <div>
                    <label class="block font-bold text-gray-700 uppercase mb-1">Identificador Corto / Slug</label>
                    <input type="text" asp-for="Slug" required placeholder="finanzaspersonales" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono focus:ring-2 focus:ring-[#1B365D]">
                    <span asp-validation-for="Slug" class="text-red-500 text-[10px]"></span>
                </div>

                <div>
                    <label class="block font-bold text-gray-700 uppercase mb-1">Correo Electrónico (Pastor / Admin)</label>
                    <input type="email" asp-for="AdminEmail" required placeholder="admin@panama.org" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D]">
                    <span asp-validation-for="AdminEmail" class="text-red-500 text-[10px]"></span>
                </div>

                <div>
                    <label class="block font-bold text-gray-700 uppercase mb-1">Contraseña de Acceso</label>
                    <input type="password" asp-for="AdminPassword" required placeholder="••••••••" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D]">
                    <span asp-validation-for="AdminPassword" class="text-red-500 text-[10px]"></span>
                </div>
            </div>
        </div>

        <div class="flex justify-end">
            <button type="submit" class="w-full md:w-auto px-8 py-3 bg-[#1B365D] text-white text-sm font-extrabold rounded-xl hover:bg-[#00A8CC] transition shadow-lg">
                Completar Registro de Iglesia <i class="fa-solid fa-arrow-right ml-2"></i>
            </button>
        </div>
    </form>

    <!-- Tabla de Iglesias Registradas -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200 space-y-4">
        <div class="flex justify-between items-center border-b border-gray-100 pb-3">
            <h2 class="text-base font-bold text-[#1B365D] flex items-center">
                <i class="fa-solid fa-building-columns text-[#00A8CC] mr-2"></i> Iglesias Registradas en la Plataforma
            </h2>
            <span class="text-xs text-gray-500 font-semibold">Total: @churches.Count()</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="text-gray-400 uppercase border-b border-gray-100 text-[10px]">
                        <th class="py-2">Nombre / Slug</th>
                        <th class="py-2">Plan</th>
                        <th class="py-2">Límite Miembros</th>
                        <th class="py-2">Ref. Pago</th>
                        <th class="py-2 text-center">Estado</th>
                        <th class="py-2 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (!churches.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-6 text-center text-gray-400 italic">No hay iglesias registradas todavía.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var church in churches)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="py-3">
                                    <span class="font-bold text-[#1B365D] block">@church.Name</span>
                                    <span class="text-[10px] text-gray-400 font-mono">/@church.Slug</span>
                                </td>
                                <td class="py-3">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-[#00A8CC]/10 text-[#00A8CC]">
                                        @church.SubscriptionPlan
                                    </span>
                                </td>
                                <td class="py-3 font-semibold text-gray-600">@church.MaxMembers máx.</td>
                                <td class="py-3 font-mono text-[11px] text-gray-500">
                                    @(string.IsNullOrWhiteSpace(church.PaymentReference) ? "N/A" : church.PaymentReference)
                                </td>
                                <td class="py-3 text-center">
                                    @if (church.SubscriptionStatus == "PENDING_VERIFICATION")
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-amber-100 text-amber-800 border border-amber-200 inline-flex items-center">
                                            <i class="fa-solid fa-clock mr-1"></i> PENDING_VERIFICATION
                                        </span>
                                    }
                                    else if (church.SubscriptionStatus == "ACTIVE")
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-emerald-100 text-emerald-800 border border-emerald-200 inline-flex items-center">
                                            <i class="fa-solid fa-circle-check mr-1"></i> ACTIVE
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-gray-100 text-gray-600">
                                            @church.SubscriptionStatus
                                        </span>
                                    }
                                </td>
                                <td class="py-3 text-right">
                                    @if (church.SubscriptionStatus == "PENDING_VERIFICATION")
                                    {
                                        <form asp-controller="SaaSChurch" asp-action="ActivateChurch" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="churchId" value="@church.Id" />
                                            <button type="submit"
                                                    onclick="return confirm('¿Confirmas que verificaste el pago de @church.Name para darle de alta de inmediato?');"
                                                    class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-bold rounded-lg shadow-sm transition inline-flex items-center space-x-1">
                                                <i class="fa-solid fa-check"></i>
                                                <span>Aprobar y Activar</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] text-emerald-600 font-bold flex items-center justify-end">
                                            <i class="fa-solid fa-user-check mr-1"></i> Operativo
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>