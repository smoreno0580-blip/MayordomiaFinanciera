@using System.Data
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_Layout";

    var spanishSpeakingCountries = new List<string>
    {
        "Panamá", "España", "Argentina", "Bolivia", "Chile", "Colombia", "Costa Rica",
        "Cuba", "Ecuador", "El Salvador", "Guatemala", "Honduras", "México",
        "Nicaragua", "Paraguay", "Perú", "República Dominicana", "Uruguay", "Venezuela"
    };

    DataTable groupsTable = ViewBag.GroupsList as DataTable ?? ViewBag.Groups as DataTable ?? new DataTable();
}
@if (ViewBag.DebugMessage != null)
{
    <div style="background: #ffeeba; color: #856404; padding: 10px; margin-bottom: 10px; border-radius: 5px; font-size: 12px; font-weight: bold;">
        ⚠️ @ViewBag.DebugMessage
    </div>
}
<div class="flex-grow flex flex-col lg:flex-row min-h-[80vh]">
    <!-- Panel Izquierdo Informativo -->
    <div class="lg:w-1/2 bg-[#1B365D] text-white flex flex-col justify-between p-8 lg:p-16 relative overflow-hidden rounded-l-2xl shadow-xl">
        <div class="absolute -right-10 -bottom-10 opacity-10 text-9xl text-[#00A8CC] pointer-events-none">
            <i class="fa-solid fa-hand-holding-dollar"></i>
        </div>
        <div class="z-10">
            <div class="flex items-center space-x-3 mb-8">
                <div class="w-12 h-12 bg-[#00A8CC] rounded-lg flex items-center justify-center shadow-lg">
                    <i class="fa-solid fa-scale-balanced text-xl text-[#1B365D]"></i>
                </div>
                <div>
                    <h2 class="font-bold text-lg leading-tight">Finanzas Bíblicas</h2>
                    <p class="text-xs text-[#00A8CC] tracking-wider uppercase font-semibold">Financial Ministries</p>
                </div>
            </div>
            <h1 class="text-3xl lg:text-5xl font-extrabold leading-tight mb-4">Finanzas<br><span class="text-[#00A8CC]">a la manera de Dios</span></h1>
            <p class="text-gray-300 text-base lg:text-lg max-w-md leading-relaxed">
                Administra con sabiduría los recursos que Dios ha puesto en tus manos aplicando principios bíblicos probados.
            </p>
        </div>
        <div class="z-10 mt-12 text-xs text-gray-400">
            &copy; @DateTime.Now.Year Mayordomia Financiera Panamá. Recursos utilizados Compass. Todos los derechos reservados.
        </div>
    </div>

    <!-- Panel Derecho Formularios -->
    <div class="lg:w-1/2 bg-white flex flex-col justify-center p-8 lg:p-16 rounded-r-2xl shadow-xl">
        <div class="max-w-md w-full mx-auto">
            <!-- Pestañas de Navegación -->
            <div class="flex border-b border-gray-200 mb-8">
                <button type="button" onclick="switchAuthTab('login')" id="tab-login-btn" class="pb-3 px-4 font-semibold text-sm border-b-2 border-[#00A8CC] text-[#1B365D] transition-all">
                    Iniciar Sesión
                </button>
                <button type="button" onclick="switchAuthTab('register')" id="tab-register-btn" class="pb-3 px-4 font-semibold text-sm border-b-2 border-transparent text-gray-400 hover:text-gray-600 transition-all">
                    Registro General de Usuarios
                </button>
            </div>

            <!-- Formulario de Login -->
            <div id="auth-login-form">
                <h3 class="text-2xl font-bold text-[#1B365D] mb-2">Bienvenido de nuevo</h3>
                <p class="text-sm text-gray-500 mb-6">Ingresa tus credenciales para acceder al sistema.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-600 text-xs rounded-lg">
                        Correo o contraseña incorrectos. Por favor verifique.
                    </div>
                }

                <form asp-action="Login" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Correo Electrónico</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400"><i class="fa-solid fa-envelope"></i></span>
                            <input type="email" name="email" required placeholder="correo@ejemplo.com" class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Contraseña</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400"><i class="fa-solid fa-lock"></i></span>
                            <input type="password" name="password" required placeholder="••••••••" class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                        </div>
                        <div class="flex justify-end items-center text-xs mt-2 mb-4">
                            <button type="button" onclick="openForgotPasswordModal()" class="text-[#00A8CC] hover:underline font-semibold">
                                ¿Olvidaste tu contraseña?
                            </button>
                        </div>
                    </div>
                    <button type="submit" class="w-full bg-[#1B365D] text-white py-3 rounded-lg font-semibold hover:bg-opacity-90 transition-all shadow-md">
                        Ingresar al Sistema
                    </button>
                </form>
            </div>

            <!-- Formulario de Registro -->
            <div id="auth-register-form" class="hidden">
                <h3 class="text-2xl font-bold text-[#1B365D] mb-2">Inscripción de Alumno</h3>
                <p class="text-sm text-gray-500 mb-6">Regístrate para comenzar tu formación en Mayordomía.</p>
                <form asp-action="Register" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Nombre Completo</label>
                        <input type="text" name="name" required placeholder="Juan Pérez" class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Correo Electrónico</label>
                            <input type="email" name="email" required placeholder="juan@ejemplo.com" class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Teléfono</label>
                            <input type="tel" name="phone" placeholder="+507 6000-0000" class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Contraseña</label>
                            <input type="password" name="password" required placeholder="••••••••" class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Cumpleaños</label>
                            <input type="date" name="birthDate" required class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">País de Origen</label>
                            <select name="country" class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                                @foreach (var c in spanishSpeakingCountries)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Grupo Asignado</label>
                            <select name="groupId" class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                                <option value="">Seleccione un grupo...</option>
                                @if (ViewBag.GroupsList != null)
                                {
                                    var groupsTbl = ViewBag.GroupsList as System.Data.DataTable;
                                    if (groupsTbl != null && groupsTbl.Rows.Count > 0)
                                    {
                                        foreach (System.Data.DataRow gRow in groupsTbl.Rows)
                                        {
                                            var gId = groupsTbl.Columns.Contains("Id") ? gRow["Id"] : groupsTbl.Columns.Contains("id") ? gRow["id"] : null;
                                            var gName = groupsTbl.Columns.Contains("Name") ? gRow["Name"] : groupsTbl.Columns.Contains("name") ? gRow["name"] : "";
                                            var gCountry = groupsTbl.Columns.Contains("Country") ? gRow["Country"] : groupsTbl.Columns.Contains("country") ? gRow["country"] : "";

                                            <option value="@gId">@gName (@gCountry)</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="w-full bg-[#00A8CC] text-[#1B365D] font-bold py-3 rounded-lg hover:bg-[#A88647] hover:text-white transition-all shadow-md">
                        Completar Inscripción
                    </button>
                    <p class="text-xs text-gray-500 mt-2">***IMPORTANTE*** Sus datos serán utilizados de forma confidencial. Solo para uso de los estudios de Finanzas Personales.</p>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Recuperación de Contraseña -->
<div id="forgotPasswordModal" class="fixed inset-0 z-50 hidden bg-black bg-opacity-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-6">
        <div class="flex justify-between items-center mb-4 pb-2 border-b border-gray-100">
            <h3 class="text-xl font-bold text-[#1B365D] flex items-center">
                <i class="fa-solid fa-lock mr-2 text-[#00A8CC]"></i> Recuperar Contraseña
            </h3>
            <button type="button" onclick="closeForgotPasswordModal()" class="text-gray-400 hover:text-gray-600"><i class="fa-solid fa-xmark text-lg"></i></button>
        </div>
        <form onsubmit="handleForgotPasswordSubmit(event)" class="space-y-4">
            @Html.AntiForgeryToken()
            <p class="text-xs text-gray-600 leading-relaxed">
                Ingresa tu correo electrónico registrado. Te enviaremos una contraseña temporal a tu bandeja de entrada.
            </p>
            <div>
                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Correo Electrónico</label>
                <input type="email" id="forgot-email-input" required placeholder="tu_correo@ejemplo.com" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
            </div>
            <div class="flex justify-end space-x-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="closeForgotPasswordModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-semibold">Cancelar</button>
                <button type="submit" class="px-5 py-2 bg-[#1B365D] text-white rounded-lg text-sm font-semibold">Enviar Instrucciones</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openForgotPasswordModal() {
        document.getElementById('forgotPasswordModal').classList.remove('hidden');
    }

    function closeForgotPasswordModal() {
        document.getElementById('forgotPasswordModal').classList.add('hidden');
    }

    async function handleForgotPasswordSubmit(e) {
        e.preventDefault();
        const email = document.getElementById('forgot-email-input').value;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        try {
            const response = await fetch('/Account/ForgotPassword', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `email=${encodeURIComponent(email)}`
            });

            const result = await response.json();
            if (result.success) {
                alert(result.message);
                closeForgotPasswordModal();
            } else {
                alert(result.message);
            }
        } catch (err) {
            console.error(err);
            alert('Error al procesar la solicitud de recuperación.');
        }
    }
</script>

@section Scripts {
    <script>
        function switchAuthTab(tab) {
            const loginBtn = document.getElementById('tab-login-btn');
            const registerBtn = document.getElementById('tab-register-btn');
            const loginForm = document.getElementById('auth-login-form');
            const registerForm = document.getElementById('auth-register-form');

            if (tab === 'login') {
                loginBtn.className = "pb-3 px-4 font-semibold text-sm border-b-2 border-[#00A8CC] text-[#1B365D]";
                registerBtn.className = "pb-3 px-4 font-semibold text-sm border-b-2 border-transparent text-gray-400 hover:text-gray-600";
                loginForm.classList.remove('hidden');
                registerForm.classList.add('hidden');
            } else {
                registerBtn.className = "pb-3 px-4 font-semibold text-sm border-b-2 border-[#00A8CC] text-[#1B365D]";
                loginBtn.className = "pb-3 px-4 font-semibold text-sm border-b-2 border-transparent text-gray-400 hover:text-gray-600";
                registerForm.classList.remove('hidden');
                loginForm.classList.add('hidden');
            }
        }
    </script>
}