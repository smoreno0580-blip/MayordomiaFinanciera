@model MayordomiaFinanciera.Web.Models.Church.VolunteerTeamDto
@{
    ViewData["Title"] = Model.Name;
    Layout = "_Layout";
}

<div class="max-w-4xl mx-auto space-y-8 py-6 px-4">
    <div class="bg-white p-6 rounded-3xl shadow-md border border-gray-200 flex justify-between items-center">
        <div class="space-y-1">
            <a asp-action="Index" class="text-xs text-[#00A8CC] font-bold hover:underline"><i class="fa-solid fa-arrow-left mr-1"></i> Volver a Equipos</a>
            <h1 class="text-2xl font-black text-[#1B365D]">@Model.Name</h1>
            <p class="text-xs text-gray-500">@Model.Description</p>
        </div>
        <div class="text-right">
            <span class="text-[10px] font-extrabold uppercase bg-sky-50 text-[#00A8CC] px-3 py-1.5 rounded-full">Líder: @(Model.LeaderName ?? "No asignado")</span>
        </div>
    </div>

    <!-- Agregar Miembro -->
    <div class="bg-white p-6 rounded-3xl shadow-md border border-gray-200 space-y-4">
        <h2 class="text-xs font-black text-[#1B365D] uppercase tracking-wider">Inscribir Servidor en este Equipo</h2>
        <form asp-action="AddMember" method="post" class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
            @Html.AntiForgeryToken()
            <input type="hidden" name="TeamId" value="@Model.Id" />
            <input type="text" name="MemberName" required placeholder="Nombre completo" class="px-3.5 py-2.5 border rounded-xl" />
            <input type="text" name="RoleInTeam" placeholder="Rol (Ej: Guitarrista, Ujier)" class="px-3.5 py-2.5 border rounded-xl" />
            <button type="submit" class="py-2.5 bg-[#00A8CC] text-white font-bold rounded-xl hover:bg-[#1B365D] transition">Añadir Servidor</button>
        </form>
    </div>

    <!-- Lista de Servidores -->
    <div class="bg-white p-6 rounded-3xl shadow-md border border-gray-200 space-y-4">
        <h2 class="text-xs font-black text-[#1B365D] uppercase tracking-wider">Servidores Asignados</h2>
        @if (!Model.Members.Any())
        {
            <p class="text-xs text-gray-400 py-4 text-center">No hay servidores registrados en este equipo todavía.</p>
        }
        else
        {
            <div class="divide-y divide-gray-100 text-xs">
                @foreach (var member in Model.Members)
                {
                    <div class="py-3 flex justify-between items-center">
                        <div>
                            <strong class="text-gray-800 font-bold block">@member.MemberName</strong>
                            <span class="text-gray-400 text-[11px]">Rol: @(string.IsNullOrWhiteSpace(member.RoleInTeam) ? "Servidor general" : member.RoleInTeam)</span>
                        </div>
                        <form asp-action="RemoveMember" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="memberId" value="@member.Id" />
                            <input type="hidden" name="teamId" value="@Model.Id" />
                            <button type="submit" class="text-red-500 hover:text-red-700 font-bold p-2"><i class="fa-solid fa-trash"></i></button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</div>