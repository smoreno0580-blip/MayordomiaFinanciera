@model MayordomiaFinanciera.Web.Models.Church.BulletinDto
@{
    ViewData["Title"] = Model.Id == Guid.Empty ? "Publicar Boletín" : "Editar Boletín";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto px-4 py-8 space-y-6">
    <div class="border-b pb-4">
        <a href="@Url.Action("Index", "Bulletins")" class="text-xs font-bold text-[#00A8CC] hover:underline mb-1 inline-block">
            <i class="fa-solid fa-arrow-left mr-1"></i> Volver a Boletines
        </a>
        <h1 class="text-2xl font-black text-[#1B365D]">
            @(Model.Id == Guid.Empty ? "Publicar Nuevo Aviso" : "Editar Aviso Ministerial")
        </h1>
        <p class="text-xs text-gray-500">Comparte información relevante con toda la congregación de forma directa.</p>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <form asp-action="Upsert" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ChurchId" />

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Título del Boletín / Aviso *</label>
                <input asp-for="Title" type="text" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" placeholder="Ej. Gran Vigilia Congregacional" required />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Fecha de Publicación</label>
                    <input asp-for="PublishDate" type="date" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" />
                </div>
                <div class="flex items-center pt-5">
                    <label class="flex items-center space-x-2 cursor-pointer">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-[#00A8CC] border-gray-300 rounded focus:ring-[#00A8CC]" />
                        <span class="text-xs font-bold text-gray-700 uppercase">Visible para la congregación</span>
                    </label>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Contenido del Mensaje *</label>
                <textarea asp-for="Content" rows="6" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" placeholder="Escribe los detalles del anuncio..." required></textarea>
            </div>

            <div class="pt-2 flex items-center justify-end space-x-3">
                <a href="@Url.Action("Index", "Bulletins")" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-xl transition">
                    Cancelar
                </a>
                <button type="submit" class="px-6 py-2.5 bg-[#00A8CC] hover:bg-[#008fa8] text-white font-bold text-xs rounded-xl shadow transition">
                    Guardar y Publicar
                </button>
            </div>
        </form>
    </div>
</div>