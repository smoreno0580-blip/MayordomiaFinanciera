@model MayordomiaFinanciera.Web.Models.Church.SmallGroupDto
@{
    ViewData["Title"] = Model.Id == Guid.Empty ? "Crear Grupo Pequeño" : "Editar Grupo Pequeño";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto px-4 py-8 space-y-6">
    <div class="border-b pb-4">
        <a href="@Url.Action("Index", "SmallGroups")" class="text-xs font-bold text-[#00A8CC] hover:underline mb-1 inline-block">
            <i class="fa-solid fa-arrow-left mr-1"></i> Volver a Grupos Pequeños
        </a>
        <h1 class="text-2xl font-black text-[#1B365D]">
            @(Model.Id == Guid.Empty ? "Crear Nuevo Grupo Pequeño (Célula)" : "Editar Grupo Pequeño")
        </h1>
        <p class="text-xs text-gray-500">Configura los detalles del grupo, horario, ubicación y asigna su líder responsable.</p>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <form asp-action="Upsert" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ChurchId" />

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Nombre del Grupo / Célula *</label>
                <input asp-for="Name" type="text" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" placeholder="Ej. Célula Jóvenes Betania" required />
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Descripción o Propósito</label>
                <textarea asp-for="Description" rows="3" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" placeholder="Descripción breve del grupo o enfoque espiritual..."></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Día de Reunión</label>
                    <select asp-for="MeetingDay" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none font-bold text-[#1B365D]">
                        <option value="Lunes">Lunes</option>
                        <option value="Martes">Martes</option>
                        <option value="Miércoles">Miércoles</option>
                        <option value="Jueves">Jueves</option>
                        <option value="Viernes">Viernes</option>
                        <option value="Sábado">Sábado</option>
                        <option value="Domingo">Domingo</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Hora de Reunión</label>
                    <input asp-for="MeetingTime" type="time" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Ubicación o Enlace (Zoom/Meet)</label>
                <input asp-for="Location" type="text" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" placeholder="Ej. Casa de la Familia Pérez, Calle 50 / Enlace de Zoom" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Nombre del Líder a Cargo</label>
                    <input asp-for="LeaderName" type="text" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" placeholder="Ej. Juan Carlos Ramos" />
                </div>
                <div class="flex items-center pt-5">
                    <label class="flex items-center space-x-2 cursor-pointer">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-[#00A8CC] border-gray-300 rounded focus:ring-[#00A8CC]" />
                        <span class="text-xs font-bold text-gray-700 uppercase">Célula Activa</span>
                    </label>
                </div>
            </div>

            <div class="pt-2 flex items-center justify-end space-x-3">
                <a href="@Url.Action("Index", "SmallGroups")" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-xl transition">
                    Cancelar
                </a>
                <button type="submit" class="px-6 py-2.5 bg-[#00A8CC] hover:bg-[#008fa8] text-white font-bold text-xs rounded-xl shadow transition">
                    Guardar Grupo
                </button>
            </div>
        </form>
    </div>
</div>