@model MayordomiaFinanciera.Web.Models.DebtSnowball.DebtSnowballViewModel
@{
    ViewData["Title"] = "Plan Bola de Nieve - Salida de Deudas";
    Layout = "_Layout";
}

<div class="space-y-6">

    <!-- Header de la Herramienta -->
    <div class="bg-[#1B365D] text-white p-6 rounded-2xl shadow-lg flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <span class="text-xs font-bold uppercase text-[#00A8CC] tracking-widest block mb-1">Mayordomía Financiera</span>
            <h1 class="text-2xl font-extrabold flex items-center">
                <i class="fa-solid fa-snowflake text-[#00A8CC] mr-3"></i> Plan Bola de Nieve
            </h1>
            <p class="text-gray-300 text-xs mt-1">Estrategia acelerada para pagar deudas de menor a mayor saldo y alcanzar la libertad financiera.</p>
        </div>
        <button type="button" onclick="openDebtModal()" class="px-4 py-2 bg-[#00A8CC] text-white font-bold text-xs rounded-xl hover:bg-[#0090B0] transition shadow flex items-center space-x-1.5">
            <i class="fa-solid fa-plus"></i>
            <span>Agregar Deuda</span>
        </button>
    </div>

    <!-- Panel KPI y Acelerador -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
            <span class="text-xs font-bold text-gray-500 uppercase tracking-wider block">Deuda Total Pendiente</span>
            <div id="kpi-total-balance" class="text-2xl font-black text-red-600 mt-1">$0.00</div>
        </div>

        <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
            <span class="text-xs font-bold text-gray-500 uppercase tracking-wider block">Pago Mínimo Requerido</span>
            <div id="kpi-total-min-payment" class="text-2xl font-black text-[#1B365D] mt-1">$0.00</div>
        </div>

        <div class="bg-white p-5 rounded-2xl shadow-sm border border-cyan-200 bg-cyan-50/30">
            <label class="text-xs font-bold text-cyan-900 uppercase tracking-wider block mb-1">Acelerador Extra / Mes ($)</label>
            <input type="number" step="0.01" min="0" id="extra-payment-input" value="@Model.ExtraMonthlyPayment" oninput="calculateSnowballSimulation()" class="w-full px-3 py-1.5 border border-cyan-300 rounded-lg text-sm font-mono font-bold text-[#1B365D]" placeholder="0.00">
        </div>

        <div class="bg-[#1B365D] text-white p-5 rounded-2xl shadow-md flex flex-col justify-between">
            <span class="text-xs font-bold text-[#00A8CC] uppercase tracking-wider block">Fecha Estimada de Lib. Financiera</span>
            <div id="kpi-freedom-date" class="text-xl font-black text-emerald-400 mt-1">Calculando...</div>
        </div>
    </div>

    <!-- Tabla de Deudas Registradas -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5">
        <h3 class="text-sm font-extrabold text-[#1B365D] mb-4 flex items-center justify-between">
            <span><i class="fa-solid fa-list-ol text-[#00A8CC] mr-2"></i> Acreedores Ordenados por Estrategia (Bola de Nieve)</span>
            <span class="text-xs text-gray-400 font-normal">Se prioriza pagar la deuda de menor saldo primero</span>
        </h3>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
                <thead>
                    <tr class="bg-gray-100 text-[11px] font-bold text-gray-600 uppercase border-b border-gray-200">
                        <th class="py-2.5 px-4">Prioridad</th>
                        <th class="py-2.5 px-4">Acreedor / Tarjeta</th>
                        <th class="py-2.5 px-3 text-right">Saldo Pendiente ($)</th>
                        <th class="py-2.5 px-3 text-right">Pago Mínimo ($)</th>
                        <th class="py-2.5 px-3 text-right">Tasa Int. Anual (%)</th>
                        <th class="py-2.5 px-4 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="debts-tbody" class="divide-y divide-gray-100">
                    <!-- Se llena con JavaScript -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Proyección / Calendario de Pagos Simulados -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-5">
        <h3 class="text-sm font-extrabold text-[#1B365D] mb-2 flex items-center">
            <i class="fa-solid fa-calendar-check text-emerald-500 mr-2"></i> Proyección Mensual de Eliminación de Deudas
        </h3>
        <p class="text-xs text-gray-500 mb-4">A medida que liquidas cada deuda, su pago mínimo se suma al acelerador acumulado para la siguiente.</p>

        <div class="overflow-x-auto max-h-80">
            <table class="w-full text-left text-xs border-collapse">
                <thead>
                    <tr class="bg-gray-100 text-[11px] font-bold text-gray-600 uppercase border-b border-gray-200">
                        <th class="py-2 px-3">Mes</th>
                        <th class="py-2 px-3">Deuda Objetivo Focus</th>
                        <th class="py-2 px-3 text-right">Pago Total Aplicado ($)</th>
                        <th class="py-2 px-3 text-right">Saldo Restante ($)</th>
                        <th class="py-2 px-3 text-center">Estado</th>
                    </tr>
                </thead>
                <tbody id="simulation-tbody" class="divide-y divide-gray-100">
                    <!-- Se calcula dinámicamente -->
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Modal Agregar / Editar Deuda -->
<div id="debtModal" class="fixed inset-0 z-50 hidden bg-black bg-opacity-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6">
        <div class="flex justify-between items-center mb-4 pb-2 border-b border-gray-100">
            <h3 id="modal-debt-title" class="text-base font-bold text-[#1B365D]">
                <i class="fa-solid fa-credit-card text-[#00A8CC] mr-2"></i> Agregar Deuda
            </h3>
            <button type="button" onclick="closeDebtModal()" class="text-gray-400 hover:text-gray-600"><i class="fa-solid fa-xmark text-lg"></i></button>
        </div>
        <form onsubmit="saveDebtForm(event)" class="space-y-4 text-xs">
            @Html.AntiForgeryToken()
            <input type="hidden" id="debt-id" value="0">
            <div>
                <label class="block font-semibold text-gray-700 uppercase mb-1">Nombre del Acreedor / Banco</label>
                <input type="text" id="debt-creditor" required placeholder="Ej: Tarjeta Visa, Préstamo Personal" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D]">
            </div>
            <div>
                <label class="block font-semibold text-gray-700 uppercase mb-1">Saldo Actual Pendiente ($)</label>
                <input type="number" step="0.01" min="0.01" id="debt-balance" required placeholder="0.00" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono focus:ring-2 focus:ring-[#1B365D]">
            </div>
            <div>
                <label class="block font-semibold text-gray-700 uppercase mb-1">Pago Mínimo Mensual ($)</label>
                <input type="number" step="0.01" min="0" id="debt-min-payment" required placeholder="0.00" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono focus:ring-2 focus:ring-[#1B365D]">
            </div>
            <div>
                <label class="block font-semibold text-gray-700 uppercase mb-1">Tasa de Interés Anual (%)</label>
                <input type="number" step="0.01" min="0" id="debt-interest" required placeholder="Ej: 18.5" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono focus:ring-2 focus:ring-[#1B365D]">
            </div>
            <div class="flex justify-end space-x-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="closeDebtModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg font-semibold">Cancelar</button>
                <button type="submit" class="px-5 py-2 bg-[#1B365D] text-white rounded-lg font-semibold">Guardar Deuda</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let debtsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Debts));

        document.addEventListener("DOMContentLoaded", () => {
            renderDebtsTable();
            calculateSnowballSimulation();
        });

        function renderDebtsTable() {
            debtsData.sort((a, b) => a.CurrentBalance - b.CurrentBalance);
            const tbody = document.getElementById('debts-tbody');

            if (debtsData.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="py-6 text-center text-gray-400">No tienes deudas registradas. ¡Excelente trabajo o agrega una para comenzar!</td></tr>';
                document.getElementById('kpi-total-balance').textContent = "$0.00";
                document.getElementById('kpi-total-min-payment').textContent = "$0.00";
                return;
            }

            let totalBalance = 0;
            let totalMin = 0;

            tbody.innerHTML = debtsData.map((debt, index) => {
                totalBalance += debt.CurrentBalance;
                totalMin += debt.MinimumPayment;

                return `
                    <tr class="hover:bg-gray-50 transition">
                        <td class="py-2.5 px-4 font-bold text-[#00A8CC]">#${index + 1}</td>
                        <td class="py-2.5 px-4 font-extrabold text-gray-800">${debt.CreditorName}</td>
                        <td class="py-2.5 px-3 text-right font-mono font-bold text-red-600">$${debt.CurrentBalance.toFixed(2)}</td>
                        <td class="py-2.5 px-3 text-right font-mono text-gray-700">$${debt.MinimumPayment.toFixed(2)}</td>
                        <td class="py-2.5 px-3 text-right font-mono text-gray-600">${debt.InterestRate.toFixed(2)}%</td>
                        <td class="py-2.5 px-4 text-center space-x-2">
                            <button onclick="editDebt(${debt.Id})" class="p-1 text-blue-600 hover:text-blue-800" title="Editar"><i class="fa-solid fa-pen-to-square"></i></button>
                            <button onclick="deleteDebt(${debt.Id})" class="p-1 text-red-600 hover:text-red-800" title="Eliminar"><i class="fa-solid fa-trash-can"></i></button>
                        </td>
                    </tr>
                `;
            }).join('');

            document.getElementById('kpi-total-balance').textContent = `$${totalBalance.toFixed(2)}`;
            document.getElementById('kpi-total-min-payment').textContent = `$${totalMin.toFixed(2)}`;
        }

        function calculateSnowballSimulation() {
            const extraPayment = parseFloat(document.getElementById('extra-payment-input').value) || 0;
            const simulationTbody = document.getElementById('simulation-tbody');

            if (debtsData.length === 0) {
                simulationTbody.innerHTML = '<tr><td colspan="5" class="py-4 text-center text-gray-400">Sin deudas para simular.</td></tr>';
                document.getElementById('kpi-freedom-date').textContent = "¡Sin Deudas!";
                return;
            }

            let activeDebts = debtsData.map(d => ({
                id: d.Id,
                name: d.CreditorName,
                balance: d.CurrentBalance,
                minPayment: d.MinimumPayment,
                rate: d.InterestRate / 12 / 100
            }));

            activeDebts.sort((a, b) => a.balance - b.balance);

            let months = 0;
            let scheduleRows = [];
            const currentDate = new Date();

            while (activeDebts.some(d => d.balance > 0) && months < 360) {
                months++;
                currentDate.setMonth(currentDate.getMonth() + 1);

                let monthlyExtraRollover = extraPayment;

                for (let i = 0; i < activeDebts.length; i++) {
                    let d = activeDebts[i];
                    if (d.balance <= 0) continue;

                    let interest = d.balance * d.rate;
                    d.balance += interest;

                    let payment = d.minPayment;

                    if (i === activeDebts.findIndex(x => x.balance > 0)) {
                        payment += monthlyExtraRollover;
                    }

                    if (payment >= d.balance) {
                        payment = d.balance;
                        d.balance = 0;
                    } else {
                        d.balance -= payment;
                    }

                    scheduleRows.push({
                        month: months,
                        dateLabel: currentDate.toLocaleDateString('es-ES', { month: 'short', year: 'numeric' }),
                        name: d.name,
                        payment: payment,
                        remaining: d.balance,
                        isPaidOff: d.balance === 0
                    });
                }
            }

            document.getElementById('kpi-freedom-date').textContent = currentDate.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });

            const first15 = scheduleRows.slice(0, 20);
            simulationTbody.innerHTML = first15.map(row => `
                <tr class="hover:bg-gray-50 transition ${row.isPaidOff ? 'bg-emerald-50' : ''}">
                    <td class="py-2 px-3 font-mono text-gray-600">Mes ${row.month} (${row.dateLabel})</td>
                    <td class="py-2 px-3 font-bold text-gray-800">${row.name}</td>
                    <td class="py-2 px-3 text-right font-mono font-bold text-[#1B365D]">$${row.payment.toFixed(2)}</td>
                    <td class="py-2 px-3 text-right font-mono ${row.remaining === 0 ? 'text-emerald-600 font-bold' : 'text-gray-700'}">$${row.remaining.toFixed(2)}</td>
                    <td class="py-2 px-3 text-center">
                        ${row.isPaidOff ? '<span class="px-2 py-0.5 text-[10px] bg-emerald-100 text-emerald-800 rounded-full font-bold">¡PAGADA!</span>' : '<span class="text-gray-400">En proceso</span>'}
                    </td>
                </tr>
            `).join('');

            saveSnowballConfig(extraPayment);
        }

        async function saveSnowballConfig(extra) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            try {
                await fetch('/DebtSnowball/SaveConfig', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ extraMonthlyPayment: extra, strategyType: "SNOWBALL" })
                });
            } catch (err) {}
        }

        function openDebtModal() {
            document.getElementById('debt-id').value = "0";
            document.getElementById('debt-creditor').value = "";
            document.getElementById('debt-balance').value = "";
            document.getElementById('debt-min-payment').value = "";
            document.getElementById('debt-interest').value = "";
            document.getElementById('modal-debt-title').innerHTML = '<i class="fa-solid fa-credit-card text-[#00A8CC] mr-2"></i> Agregar Deuda';
            document.getElementById('debtModal').classList.remove('hidden');
        }

        function editDebt(id) {
            const debt = debtsData.find(d => d.Id === id);
            if (!debt) return;
            document.getElementById('debt-id').value = debt.Id;
            document.getElementById('debt-creditor').value = debt.CreditorName;
            document.getElementById('debt-balance').value = debt.CurrentBalance;
            document.getElementById('debt-min-payment').value = debt.MinimumPayment;
            document.getElementById('debt-interest').value = debt.InterestRate;
            document.getElementById('modal-debt-title').innerHTML = '<i class="fa-solid fa-pen-to-square text-[#00A8CC] mr-2"></i> Editar Deuda';
            document.getElementById('debtModal').classList.remove('hidden');
        }

        function closeDebtModal() {
            document.getElementById('debtModal').classList.add('hidden');
        }

        async function saveDebtForm(e) {
            e.preventDefault();
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const payload = {
                id: parseInt(document.getElementById('debt-id').value) || 0,
                creditorName: document.getElementById('debt-creditor').value,
                currentBalance: parseFloat(document.getElementById('debt-balance').value) || 0,
                minimumPayment: parseFloat(document.getElementById('debt-min-payment').value) || 0,
                interestRate: parseFloat(document.getElementById('debt-interest').value) || 0
            };

            try {
                const response = await fetch('/DebtSnowball/SaveDebt', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify(payload)
                });

                const res = await response.json();
                if (res.success) {
                    showToast(res.message, 'success');
                    closeDebtModal();
                    location.reload();
                } else {
                    showToast(res.message, 'error');
                }
            } catch (err) {
                showToast('Error de conexión al guardar la deuda.', 'error');
            }
        }

        async function deleteDebt(id) {
            if (!confirm('¿Estás seguro de eliminar esta deuda?')) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const response = await fetch(`/DebtSnowball/DeleteDebt?id=${id}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });

                const res = await response.json();
                if (res.success) {
                    showToast(res.message, 'success');
                    debtsData = debtsData.filter(d => d.Id !== id);
                    renderDebtsTable();
                    calculateSnowballSimulation();
                } else {
                    showToast(res.message, 'error');
                }
            } catch (err) {
                showToast('Error al eliminar la deuda.', 'error');
            }
        }
    </script>
}