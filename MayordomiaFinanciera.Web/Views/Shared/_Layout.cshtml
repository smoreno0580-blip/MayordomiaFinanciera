<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Mayordomía y Finanzas</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Alpine.js (Requerido para la interactividad del Sidebar colapsable) -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        /* Ocultar barra de desplazamiento manteniendo la posibilidad de scroll si fuera necesario en pantallas extremadamente pequeñas */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .bg-compass-navy {
            background-color: #1B365D;
        }

        .text-compass-navy {
            color: #1B365D;
        }

        .bg-compass-gold {
            background-color: #00A8CC;
        }

        .text-compass-gold {
            color: #00A8CC;
        }

        .border-compass-gold {
            border-color: #00A8CC;
        }
    </style>
</head>
<body class="h-full bg-gray-50 text-gray-800 flex overflow-hidden" x-data="{ sidebarOpen: true, toolsOpen: true }">

    <!-- Contenedor de Notificaciones Toast -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col space-y-2"></div>

    <!-- Barra Lateral (Sidebar Fija, Compacta y Colapsable) -->
    <aside :class="sidebarOpen ? 'w-56' : 'w-16'"
           class="bg-[#1B365D] text-white h-screen sticky top-0 z-40 transition-all duration-300 flex flex-col justify-between shadow-xl shrink-0 overflow-y-auto no-scrollbar border-r border-white/10">

        <div class="flex flex-col">
            <!-- Encabezado Sidebar / Logo Compacto -->
            <div class="p-3 border-b border-white/10 flex items-center justify-between h-14 shrink-0">
                <a href="@Url.Action("Index", "Home")" class="flex items-center space-x-2.5 overflow-hidden" title="Ir al Inicio">
                    <div class="w-8 h-8 bg-[#00A8CC] rounded-lg flex items-center justify-center shrink-0 shadow">
                        <i class="fa-solid fa-scale-balanced text-[#1B365D] font-bold text-sm"></i>
                    </div>
                    <div x-show="sidebarOpen" class="transition-opacity duration-200 leading-none">
                        <span class="font-bold text-xs block text-white tracking-wide">Finanzas Bíblicas</span>
                        <span class="text-[8px] text-[#00A8CC] uppercase tracking-widest font-semibold block mt-0.5">Mayordomía</span>
                    </div>
                </a>
            </div>

            <!-- Opciones de Navegación Vertical Compactas -->
            <nav class="p-2 space-y-0.5 text-xs">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    @if (!User.IsInRole("student"))
                    {
                        <a href="@Url.Action("Index", "Dashboard")" class="flex items-center space-x-2.5 px-2.5 py-1.5 rounded-lg font-medium hover:bg-white/10 transition group" :title="sidebarOpen ? '' : 'Dashboard'">
                            <i class="fa-solid fa-chart-pie w-5 text-center text-[#00A8CC] text-sm"></i>
                            <span x-show="sidebarOpen" class="transition-opacity">Dashboard</span>
                        </a>
                        <a href="@Url.Action("Index", "Groups")" class="flex items-center space-x-2.5 px-2.5 py-1.5 rounded-lg font-medium hover:bg-white/10 transition group" :title="sidebarOpen ? '' : 'Grupos'">
                            <i class="fa-solid fa-users w-5 text-center text-[#00A8CC] text-sm"></i>
                            <span x-show="sidebarOpen" class="transition-opacity">Grupos</span>
                        </a>
                    }

                    <!-- Menú Desplegable de Herramientas Financieras dentro del Sidebar -->
                    <div class="py-0.5">
                        <button @@click="toolsOpen = !toolsOpen" class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg font-medium hover:bg-white/10 transition text-left">
                            <div class="flex items-center space-x-2.5">
                                <i class="fa-solid fa-toolbox w-5 text-center text-[#00A8CC] text-sm"></i>
                                <span x-show="sidebarOpen" class="transition-opacity">Herramientas</span>
                            </div>
                            <i x-show="sidebarOpen" class="fa-solid fa-chevron-down text-[10px] transition-transform duration-200" :class="{ 'rotate-180': toolsOpen }"></i>
                        </button>

                        <!-- Sub-opciones de Herramientas Compactas -->
                        <div x-show="toolsOpen && sidebarOpen" class="pl-3 pr-1 py-0.5 space-y-0.5 border-l border-[#00A8CC]/40 ml-4 my-0.5" style="display: none;">
                            <a href="@Url.Action("Index", "FinancialTools")" class="flex items-center space-x-2 px-2 py-1 rounded-md text-[11px] font-medium hover:bg-white/10 transition text-gray-200">
                                <i class="fa-solid fa-border-all w-3.5 text-center text-[#00A8CC]"></i>
                                <span>Hub General</span>
                            </a>
                            <a href="@Url.Action("Index", "Budget")" class="flex items-center space-x-2 px-2 py-1 rounded-md text-[11px] font-medium hover:bg-white/10 transition text-gray-200">
                                <i class="fa-solid fa-calculator w-3.5 text-center text-emerald-400"></i>
                                <span>Presupuesto Mensual</span>
                            </a>
                            <a href="@Url.Action("Index", "FinancialStatement")" class="flex items-center space-x-2 px-2 py-1 rounded-md text-[11px] font-medium hover:bg-white/10 transition text-gray-200">
                                <i class="fa-solid fa-scale-balanced w-3.5 text-center text-cyan-400"></i>
                                <span>Estado Financiero</span>
                            </a>
                            <a href="@Url.Action("Index", "DebtSnowball")" class="flex items-center space-x-2 px-2 py-1 rounded-md text-[11px] font-medium hover:bg-white/10 transition text-gray-200">
                                <i class="fa-solid fa-snowflake w-3.5 text-center text-sky-400"></i>
                                <span>Bola de Nieve</span>
                            </a>
                        </div>
                    </div>

                    <a href="@Url.Action("Index", "Sessions")" class="flex items-center space-x-2.5 px-2.5 py-1.5 rounded-lg font-medium hover:bg-white/10 transition group" :title="sidebarOpen ? '' : 'Sesiones'">
                        <i class="fa-solid fa-chalkboard-user w-5 text-center text-[#00A8CC] text-sm"></i>
                        <span x-show="sidebarOpen" class="transition-opacity">@(User.IsInRole("student") ? "Mi Sesión" : "Sesiones")</span>
                    </a>
                    @if (!User.IsInRole("student"))
                    {
                        <a href="@Url.Action("Index", "Attendance")" class="flex items-center space-x-2.5 px-2.5 py-1.5 rounded-lg font-medium hover:bg-white/10 transition group" :title="sidebarOpen ? '' : 'Asistencia'">
                            <i class="fa-solid fa-clipboard-check w-5 text-center text-[#00A8CC] text-sm"></i>
                            <span x-show="sidebarOpen" class="transition-opacity">Asistencia</span>
                        </a>
                    }
                    <a href="@Url.Action("Index", "Birthdays")" class="flex items-center space-x-2.5 px-2.5 py-1.5 rounded-lg font-medium hover:bg-white/10 transition group" :title="sidebarOpen ? '' : 'Cumpleaños'">
                        <i class="fa-solid fa-cake-candles w-5 text-center text-[#00A8CC] text-sm"></i>
                        <span x-show="sidebarOpen" class="transition-opacity">Cumpleaños</span>
                    </a>
                    @if (User.IsInRole("admin"))
                    {
                        <a href="@Url.Action("Index", "Users")" class="flex items-center space-x-2.5 px-2.5 py-1.5 rounded-lg font-medium hover:bg-white/10 transition group" :title="sidebarOpen ? '' : 'Gestión Usuarios'">
                            <i class="fa-solid fa-user-gear w-5 text-center text-[#00A8CC] text-sm"></i>
                            <span x-show="sidebarOpen" class="transition-opacity">Gestión Usuarios</span>
                        </a>
                    }
                    <a href="@Url.Action("Index", "Community")" class="flex items-center space-x-2.5 px-2.5 py-1.5 rounded-lg font-medium hover:bg-white/10 transition group" :title="sidebarOpen ? '' : 'Comunidad'">
                        <i class="fa-solid fa-comments w-5 text-center text-[#00A8CC] text-sm"></i>
                        <span x-show="sidebarOpen" class="transition-opacity">Comunidad</span>
                    </a>
                }

                <a href="@Url.Action("Index", "Donations")" class="flex items-center space-x-2.5 px-2.5 py-1.5 rounded-lg font-bold text-[#00A8CC] hover:bg-white/10 transition group">
                    <i class="fa-solid fa-heart w-5 text-center text-sm"></i>
                    <span x-show="sidebarOpen" class="transition-opacity">Donar</span>
                </a>
            </nav>
        </div>

        <!-- Botón para Colapsar/Expandir en el pie del Sidebar -->
        <div class="p-2 border-t border-white/10 shrink-0">
            <button @@click="sidebarOpen = !sidebarOpen" class="w-full flex items-center justify-center space-x-1.5 px-2 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white transition text-[11px] font-semibold">
                <i class="fa-solid" :class="sidebarOpen ? 'fa-angles-left' : 'fa-angles-right'"></i>
                <span x-show="sidebarOpen" class="transition-opacity">Colapsar</span>
            </button>
        </div>
    </aside>

    <!-- Contenedor Principal de la Página -->
    <div id="app" class="min-h-full flex flex-col flex-grow w-full overflow-y-auto">

        <!-- Barra Superior Limpia (Perfil de Usuario y Acciones Rápidas) -->
        <header class="bg-[#1B365D] text-white shadow-md sticky top-0 z-30 shrink-0">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-14">

                    <!-- Título de sección o bienvenida -->
                    <div class="flex items-center space-x-3">
                        <button @@click="sidebarOpen = !sidebarOpen" class="p-1.5 rounded-lg bg-white/10 text-white hover:bg-white/20 transition"><i class="fa-solid fa-bars text-sm"></i></button>
                        <span class="font-extrabold text-sm md:text-base text-white tracking-wide">Panel de Gestión</span>
                    </div>

                    <!-- Botones de Usuario / Acceso Derecha -->
                    <div class="flex items-center space-x-3 shrink-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="text-right hidden sm:block leading-tight">
                                <div class="text-xs font-bold">@User.Identity.Name</div>
                                <div class="text-[9px] text-[#00A8CC] uppercase tracking-wider font-semibold">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                            </div>

                            <!-- Botón rápido para ir al Landing Page -->
                            <a href="@Url.Action("Index", "Home")" class="p-1.5 rounded-lg bg-gray-700/60 hover:bg-gray-700 text-white transition-all shadow" title="Ir al Landing Page">
                                <i class="fa-solid fa-house text-xs"></i>
                            </a>

                            <!-- Botón Cambiar Contraseña en Sesión Activa -->
                            <button type="button" onclick="openChangePasswordModal()" class="p-1.5 rounded-lg bg-gray-700/60 hover:bg-gray-700 text-white transition-all shadow" title="Cambiar mi contraseña">
                                <i class="fa-solid fa-key text-xs"></i>
                            </button>

                            <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" title="Cerrar Sesión" class="p-1.5 rounded-lg bg-red-600/80 hover:bg-red-600 text-white transition-all shadow">
                                    <i class="fa-solid fa-right-from-bracket text-xs"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a href="@Url.Action("Login", "Account")" class="px-3 py-1.5 text-xs font-semibold text-white hover:text-[#00A8CC] transition-all">
                                Iniciar Sesión
                            </a>
                            <a href="@Url.Action("Login", "Account")#register" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-[#00A8CC] text-white hover:bg-[#0090B0] transition-all shadow">
                                Registrarse
                            </a>
                        }
                    </div>

                </div>
            </div>
        </header>

        <!-- Área Principal de Contenido -->
        <main id="main-content-area" class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
            @RenderBody()
        </main>
    </div>

    <!-- Modal Global -->
    <div id="global-modal" class="fixed inset-0 z-50 hidden bg-black bg-opacity-50 flex items-center justify-center p-4">
        <div id="modal-content" class="bg-white rounded-xl shadow-2xl max-w-lg w-full overflow-hidden transform transition-all"></div>
    </div>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- Modal de Cambio de Contraseña de Usuario en Sesión -->
        <div id="changePasswordModal" class="fixed inset-0 z-50 hidden bg-black bg-opacity-50 flex items-center justify-center p-4">
            <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-6">
                <div class="flex justify-between items-center mb-4 pb-2 border-b border-gray-100">
                    <h3 class="text-xl font-bold text-[#1B365D] flex items-center">
                        <i class="fa-solid fa-key mr-2 text-[#00A8CC]"></i> Cambiar Mi Contraseña
                    </h3>
                    <button type="button" onclick="closeChangePasswordModal()" class="text-gray-400 hover:text-gray-600"><i class="fa-solid fa-xmark text-lg"></i></button>
                </div>
                <form onsubmit="submitUserChangePassword(event)" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Contraseña Actual</label>
                        <input type="password" id="current-password" required placeholder="••••••••" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Nueva Contraseña</label>
                        <input type="password" id="new-password" required placeholder="••••••••" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Confirmar Nueva Contraseña</label>
                        <input type="password" id="confirm-password" required placeholder="••••••••" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                    </div>
                    <div class="flex justify-end space-x-3 pt-4 border-t border-gray-100">
                        <button type="button" onclick="closeChangePasswordModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-semibold">Cancelar</button>
                        <button type="submit" class="px-5 py-2 bg-[#1B365D] text-white rounded-lg text-sm font-semibold">Actualizar Contraseña</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Scripts auxiliares -->
    <script>
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgColor = type === 'success' ? 'bg-green-600' : type === 'error' ? 'bg-red-600' : 'bg-[#1B365D]';
            toast.className = `${bgColor} text-white px-5 py-3 rounded-lg shadow-lg flex items-center justify-between space-x-3 transition-all transform translate-y-2 opacity-0`;
            toast.innerHTML = `
                <div class="flex items-center space-x-2">
                    <i class="fa-solid ${type === 'success' ? 'fa-circle-check' : type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-info'}"></i>
                    <span class="text-sm font-medium">${message}</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-white hover:text-gray-200"><i class="fa-solid fa-xmark"></i></button>
            `;
            container.appendChild(toast);
            setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
            setTimeout(() => {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        function openChangePasswordModal() {
            document.getElementById('changePasswordModal').classList.remove('hidden');
        }

        function closeChangePasswordModal() {
            document.getElementById('changePasswordModal').classList.add('hidden');
        }

        async function submitUserChangePassword(e) {
            e.preventDefault();
            const currentPassword = document.getElementById('current-password').value;
            const newPassword = document.getElementById('new-password').value;
            const confirmPassword = document.getElementById('confirm-password').value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            if (newPassword !== confirmPassword) {
                alert('Las nuevas contraseñas no coinciden.');
                return;
            }

            try {
                const response = await fixedFetch('/Account/ChangePassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `currentPassword=${encodeURIComponent(currentPassword)}&newPassword=${encodeURIComponent(newPassword)}&confirmPassword=${encodeURIComponent(confirmPassword)}`
                });

                // ... resto del script de cambio de contraseña
            } catch (err) {
                console.error(err);
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>