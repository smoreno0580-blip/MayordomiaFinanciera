<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Mayordomía y Finanzas</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .bg-compass-navy {
            background-color: #1B365D;
        }

        .text-compass-navy {
            color: #1B365D;
        }

        .bg-compass-gold {
            background-color: #00A8CC;
        }

        .text-compass-gold {
            color: #00A8CC;
        }

        .border-compass-gold {
            border-color: #00A8CC;
        }

        .hover\:bg-compass-gold-dark:hover {
            background-color: #A88647;
        }
    </style>
</head>
<body class="h-full bg-gray-50 text-gray-800 flex flex-col">

    <!-- Contenedor de Notificaciones Toast -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col space-y-2"></div>

    <div id="app" class="min-h-full flex flex-col flex-grow">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <!-- Barra de Navegación Superior -->
            <nav class="bg-[#1B365D] text-white shadow-md">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex justify-between h-16">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-[#00A8CC] rounded-lg flex items-center justify-center">
                                <i class="fa-solid fa-scale-balanced text-[#1B365D] font-bold"></i>
                            </div>
                            <div>
                                <span class="font-bold text-lg tracking-wide">Finanzas Bíblicas</span>
                                <span class="block text-[10px] text-[#00A8CC] uppercase tracking-widest font-semibold">Mayordomía y Finanzas</span>
                            </div>
                        </div>
                        <div class="hidden md:flex items-center space-x-1">
                            <!-- Dashboard: Visible solo para admin y teachers -->
                            @if (!User.IsInRole("student"))
                            {
                                <a href="@Url.Action("Index", "Dashboard")" class="px-3 py-2 rounded-md text-sm font-medium transition-all hover:bg-white/15">Dashboard</a>
                            }

                            <!-- Grupos: Restringido estrictamente a admin y teachers -->
                            @if (User.IsInRole("admin") || User.IsInRole("teacher"))
                            {
                                <a href="@Url.Action("Index", "Groups")" class="px-3 py-2 rounded-md text-sm font-medium transition-all hover:bg-white/15">Grupos</a>
                            }

                            <!-- Sesiones: Estudiantes ven "Mi Sesión" filtrada; Admin/Teachers ven el listado completo -->
                            <a href="@Url.Action("Index", "Sessions")" class="px-3 py-2 rounded-md text-sm font-medium transition-all hover:bg-white/15">
                                @(User.IsInRole("student") ? "Mi Sesión" : "Sesiones")
                            </a>

                            <!-- Asistencia: Visible para admin y teachers -->
                            @if (!User.IsInRole("student"))
                            {
                                <a href="@Url.Action("Index", "Attendance")" class="px-3 py-2 rounded-md text-sm font-medium transition-all hover:bg-white/15">Asistencia</a>
                            }

                            <!-- Cumpleaños: Disponible para todos -->
                            <a href="@Url.Action("Index", "Birthdays")" class="px-3 py-2 rounded-md text-sm font-medium transition-all hover:bg-white/15">Cumpleaños</a>

                            <!-- Gestión Usuarios: Solo Administradores -->
                            @if (User.IsInRole("admin"))
                            {
                                <a href="@Url.Action("Index", "Users")" class="px-3 py-2 rounded-md text-sm font-medium transition-all hover:bg-white/15">Gestión Usuarios</a>
                            }

                            <!-- Comunidad: Disponible para todos -->
                            <a href="@Url.Action("Index", "Community")" class="px-3 py-2 rounded-md text-sm font-medium transition-all hover:bg-white/15">Comunidad</a>

                            <!-- Donaciones: Visible solo para admin y teachers -->
                            @if (!User.IsInRole("student"))
                            {
                                <a asp-controller="Donations" asp-action="Index" class="px-3 py-2 rounded-md text-sm font-medium transition-all text-gray-300 hover:bg-white/15 flex items-center space-x-1.5">
                                    <span>Donaciones</span>
                                </a>
                            }
                        </div>
                        <div class="flex items-center space-x-3">
                            <div class="text-right hidden sm:block">
                                <div class="text-sm font-bold">@User.Identity.Name</div>
                                <div class="text-[10px] text-[#00A8CC] uppercase tracking-wider font-semibold">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                            </div>

                            <!-- Botón Cambiar Contraseña en Sesión Activa -->
                            <button type="button" onclick="openChangePasswordModal()" class="p-2 rounded-lg bg-gray-700/60 hover:bg-gray-700 text-white transition-all" title="Cambiar mi contraseña">
                                <i class="fa-solid fa-key"></i>
                            </button>

                            <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" title="Cerrar Sesión" class="p-2 rounded-lg bg-red-600/80 hover:bg-red-600 text-white transition-all">
                                    <i class="fa-solid fa-right-from-bracket"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </nav>
        }

        <!-- Área Principal de Contenido -->
        <main id="main-content-area" class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
            @RenderBody()
        </main>
    </div>

    <!-- Modal Global -->
    <div id="global-modal" class="fixed inset-0 z-50 hidden bg-black bg-opacity-50 flex items-center justify-center p-4">
        <div id="modal-content" class="bg-white rounded-xl shadow-2xl max-w-lg w-full overflow-hidden transform transition-all"></div>
    </div>

    <!-- Modal de Cambio de Contraseña de Usuario en Sesión -->
    <div id="changePasswordModal" class="fixed inset-0 z-50 hidden bg-black bg-opacity-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-6">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-gray-100">
                <h3 class="text-xl font-bold text-[#1B365D] flex items-center">
                    <i class="fa-solid fa-key mr-2 text-[#00A8CC]"></i> Cambiar Mi Contraseña
                </h3>
                <button type="button" onclick="closeChangePasswordModal()" class="text-gray-400 hover:text-gray-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <form onsubmit="submitUserChangePassword(event)" class="space-y-4">
                @Html.AntiForgeryToken()
                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Contraseña Actual</label>
                    <input type="password" id="current-password" required placeholder="••••••••" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Nueva Contraseña</label>
                    <input type="password" id="new-password" required placeholder="••••••••" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Confirmar Nueva Contraseña</label>
                    <input type="password" id="confirm-password" required placeholder="••••••••" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                </div>
                <div class="flex justify-end space-x-3 pt-4 border-t border-gray-100">
                    <button type="button" onclick="closeChangePasswordModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-semibold">Cancelar</button>
                    <button type="submit" class="px-5 py-2 bg-[#1B365D] text-white rounded-lg text-sm font-semibold">Actualizar Contraseña</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Scripts auxiliares -->
    <script>
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgColor = type === 'success' ? 'bg-green-600' : type === 'error' ? 'bg-red-600' : 'bg-[#1B365D]';
            toast.className = `${bgColor} text-white px-5 py-3 rounded-lg shadow-lg flex items-center justify-between space-x-3 transition-all transform translate-y-2 opacity-0`;
            toast.innerHTML = `
                <div class="flex items-center space-x-2">
                    <i class="fa-solid ${type === 'success' ? 'fa-circle-check' : type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-info'}"></i>
                    <span class="text-sm font-medium">${message}</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-white hover:text-gray-200"><i class="fa-solid fa-xmark"></i></button>
            `;
            container.appendChild(toast);
            setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
            setTimeout(() => {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        // Funciones del Modal de Cambio de Contraseña en Sesión Activa
        function openChangePasswordModal() {
            document.getElementById('changePasswordModal').classList.remove('hidden');
        }

        function closeChangePasswordModal() {
            document.getElementById('changePasswordModal').classList.add('hidden');
        }

        async function submitUserChangePassword(e) {
            e.preventDefault();
            const currentPassword = document.getElementById('current-password').value;
            const newPassword = document.getElementById('new-password').value;
            const confirmPassword = document.getElementById('confirm-password').value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            if (newPassword !== confirmPassword) {
                alert('Las nuevas contraseñas no coinciden.');
                return;
            }

            try {
                const response = await fetch('/Account/ChangePassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `currentPassword=${encodeURIComponent(currentPassword)}&newPassword=${encodeURIComponent(newPassword)}&confirmPassword=${encodeURIComponent(confirmPassword)}`
                });

                const result = await response.json();
                if (result.success) {
                    alert(result.message);
                    closeChangePasswordModal();
                    document.getElementById('current-password').value = '';
                    document.getElementById('new-password').value = '';
                    document.getElementById('confirm-password').value = '';
                } else {
                    alert(result.message);
                }
            } catch (err) {
                console.error(err);
                alert('Error al intentar cambiar la contraseña.');
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>