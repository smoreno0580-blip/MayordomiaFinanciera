<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@ViewData["Title"] - Mayordomía y Finanzas</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="h-full bg-gray-50 text-gray-800 flex flex-col md:flex-row overflow-x-hidden" x-data="{ mobileOpen: false, desktopOpen: true, toolsOpen: false, ministryOpen: false }">

    <!-- Notificaciones Toast -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col space-y-2"></div>

    <!-- 1. BACKDROP OSCURO PARA MÓVILES -->
    <div x-show="mobileOpen"
         x-transition.opacity
         class="fixed inset-0 bg-black/50 z-40 md:hidden"
         @@click="mobileOpen = false"
         style="display: none;">
    </div>

    <!-- 2. SIDEBAR LATERAL -->
    <aside :class="{
                'translate-x-0': mobileOpen,
                '-translate-x-full': !mobileOpen,
                'md:translate-x-0': true,
                'md:w-56': desktopOpen,
                'md:w-16': !desktopOpen
            }"
           class="bg-[#1B365D] text-white fixed md:sticky top-0 inset-y-0 left-0 z-50 w-64 transition-transform duration-300 ease-in-out flex flex-col justify-between shadow-xl shrink-0 overflow-y-auto no-scrollbar border-r border-white/10 h-full min-h-screen">

        <div class="flex flex-col">
            <!-- Logo / Header del Sidebar -->
            <div class="p-3 border-b border-white/10 flex items-center justify-between h-14 shrink-0">
                <a href="@Url.Action("Index", "Home")" class="flex items-center space-x-2.5 overflow-hidden" title="Ir al Inicio">
                    <div class="w-8 h-8 bg-[#00A8CC] rounded-lg flex items-center justify-center shrink-0 shadow">
                        <i class="fa-solid fa-scale-balanced text-[#1B365D] font-bold text-sm"></i>
                    </div>
                    <div class="leading-none transition-opacity duration-200" :class="{ 'md:hidden': !desktopOpen }">
                        <span class="font-bold text-xs block text-white tracking-wide">Finanzas Bíblicas</span>
                        <span class="text-[8px] text-[#00A8CC] uppercase tracking-widest font-semibold block mt-0.5">Mayordomía</span>
                    </div>
                </a>

                <!-- Botón cerrar en móvil -->
                <button @@click="mobileOpen = false" class="md:hidden text-gray-300 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Navegación -->
            <nav class="p-2 space-y-0.5 text-xs">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    bool isStudentOrMember = User.IsInRole("student") || User.IsInRole("STUDENT") || User.IsInRole("miembro") || User.IsInRole("MIEMBRO");
                    bool isLeaderOrAbove = User.IsInRole("admin") || User.IsInRole("ADMIN") ||
                    User.IsInRole("pastor") || User.IsInRole("PASTOR") ||
                    User.IsInRole("copastor") || User.IsInRole("COPASTOR") ||
                    User.IsInRole("lider") || User.IsInRole("LIDER") ||
                    User.IsInRole("teacher") || User.IsInRole("TEACHER");

                    @if (!isStudentOrMember)
                    {
                        <!-- Dashboard -->
                        <a href="@Url.Action("Index", "Dashboard")" class="flex items-center space-x-2.5 px-2.5 py-2 rounded-lg font-medium hover:bg-white/10 transition group">
                            <i class="fa-solid fa-chart-pie w-5 text-center text-[#00A8CC] text-sm shrink-0"></i>
                            <span class="transition-opacity" :class="{ 'md:hidden': !desktopOpen }">Dashboard</span>
                        </a>

                        <!-- Comunidad -->
                        <a href="@Url.Action("Index", "Community")" class="flex items-center space-x-2.5 px-2.5 py-2 rounded-lg font-medium hover:bg-white/10 transition group">
                            <i class="fa-solid fa-comments w-5 text-center text-[#00A8CC] text-sm shrink-0"></i>
                            <span class="transition-opacity" :class="{ 'md:hidden': !desktopOpen }">Comunidad</span>
                        </a>

                        <!-- Donar -->
                        <a href="@Url.Action("Index", "Donations")" class="flex items-center space-x-2.5 px-2.5 py-2 rounded-lg font-bold text-[#00A8CC] hover:bg-white/10 transition group">
                            <i class="fa-solid fa-heart w-5 text-center text-sm shrink-0"></i>
                            <span class="transition-opacity" :class="{ 'md:hidden': !desktopOpen }">Donar</span>
                        </a>
                    }

                    @if (isLeaderOrAbove)
                    {
                        <a href="@Url.Action("Index", "Groups")" class="flex items-center space-x-2.5 px-2.5 py-2 rounded-lg font-medium hover:bg-white/10 transition group">
                            <i class="fa-solid fa-users w-5 text-center text-[#00A8CC] text-sm shrink-0"></i>
                            <span class="transition-opacity" :class="{ 'md:hidden': !desktopOpen }">Grupos</span>
                        </a>
                    }

                    <a href="@Url.Action("Index", "Sessions")" class="flex items-center space-x-2.5 px-2.5 py-2 rounded-lg font-medium hover:bg-white/10 transition group">
                        <i class="fa-solid fa-chalkboard-user w-5 text-center text-[#00A8CC] text-sm shrink-0"></i>
                        <span class="transition-opacity" :class="{ 'md:hidden': !desktopOpen }">@(isStudentOrMember ? "Mi Sesión" : "Sesiones")</span>
                    </a>

                    @if (!isStudentOrMember)
                    {
                        <a href="@Url.Action("Index", "Attendance")" class="flex items-center space-x-2.5 px-2.5 py-2 rounded-lg font-medium hover:bg-white/10 transition group">
                            <i class="fa-solid fa-clipboard-check w-5 text-center text-[#00A8CC] text-sm shrink-0"></i>
                            <span class="transition-opacity" :class="{ 'md:hidden': !desktopOpen }">Asistencia</span>
                        </a>
                    }

                    <a href="@Url.Action("Index", "Birthdays")" class="flex items-center space-x-2.5 px-2.5 py-2 rounded-lg font-medium hover:bg-white/10 transition group">
                        <i class="fa-solid fa-cake-candles w-5 text-center text-[#00A8CC] text-sm shrink-0"></i>
                        <span class="transition-opacity" :class="{ 'md:hidden': !desktopOpen }">Cumpleaños</span>
                    </a>

                    @if (User.IsInRole("admin") || User.IsInRole("ADMIN"))
                    {
                        <a href="@Url.Action("Index", "Users")" class="flex items-center space-x-2.5 px-2.5 py-2 rounded-lg font-medium hover:bg-white/10 transition group">
                            <i class="fa-solid fa-user-gear w-5 text-center text-[#00A8CC] text-sm shrink-0"></i>
                            <span class="transition-opacity" :class="{ 'md:hidden': !desktopOpen }">Gestión Usuarios</span>
                        </a>

                        <a href="@Url.Action("Register", "SaaSChurch")" class="flex items-center space-x-2.5 px-2.5 py-2 rounded-lg font-medium hover:bg-white/10 transition group text-amber-300">
                            <i class="fa-solid fa-church w-5 text-center text-amber-300 text-sm shrink-0"></i>
                            <span class="transition-opacity" :class="{ 'md:hidden': !desktopOpen }">Crear Iglesia (SaaS)</span>
                        </a>

                        <!-- MÓDULO SUSCRIPCIONES Y PAGOS (Para SuperAdmin) -->
                        <a href="@Url.Action("Index", "Subscription")" class="flex items-center space-x-2.5 px-2.5 py-2 rounded-lg font-medium hover:bg-white/10 transition group text-emerald-300">
                            <i class="fa-solid fa-file-invoice-dollar w-5 text-center text-emerald-300 text-sm shrink-0"></i>
                            <span class="transition-opacity" :class="{ 'md:hidden': !desktopOpen }">Suscripciones y Pagos</span>
                        </a>
                    }

                    <!-- SUBMENÚ DESPLEGABLE: GESTIÓN MINISTERIAL -->
                    @if (isLeaderOrAbove)
                    {
                        <div class="py-0.5">
                            <button @@click="ministryOpen = !ministryOpen" class="w-full flex items-center justify-between px-2.5 py-2 rounded-lg font-medium hover:bg-white/10 transition text-left text-cyan-300">
                                <div class="flex items-center space-x-2.5">
                                    <i class="fa-solid fa-church w-5 text-center text-cyan-300 text-sm shrink-0"></i>
                                    <span class="transition-opacity" :class="{ 'md:hidden': !desktopOpen }">Gestión Ministerial</span>
                                </div>
                                <i class="fa-solid fa-chevron-down text-[10px] transition-transform duration-200" :class="{ 'rotate-180': ministryOpen, 'md:hidden': !desktopOpen }"></i>
                            </button>

                            <div x-show="ministryOpen" class="pl-3 pr-1 py-0.5 space-y-0.5 border-l border-cyan-400/40 ml-4 my-0.5" :class="{ 'md:hidden': !desktopOpen }">
                                <a href="@Url.Action("Index", "ChurchAdmin")" class="flex items-center space-x-2 px-2 py-1.5 rounded-md text-[11px] font-medium hover:bg-white/10 transition text-gray-200">
                                    <i class="fa-solid fa-square-poll-vertical w-3.5 text-center text-cyan-300 shrink-0"></i>
                                    <span>Panel Eclesial</span>
                                </a>
                                <a href="@Url.Action("Index", "ChurchUsers")" class="flex items-center space-x-2 px-2 py-1.5 rounded-md text-[11px] font-medium hover:bg-white/10 transition text-gray-200">
                                    <i class="fa-solid fa-users-gear w-3.5 text-center text-amber-300 shrink-0"></i>
                                    <span>Equipo y Miembros</span>
                                </a>
                                <a href="@Url.Action("Index", "SmallGroups")" class="flex items-center space-x-2 px-2 py-1.5 rounded-md text-[11px] font-medium hover:bg-white/10 transition text-gray-200">
                                    <i class="fa-solid fa-users-line w-3.5 text-center text-[#00A8CC] shrink-0"></i>
                                    <span>Grupos Pequeños</span>
                                </a>
                                <a href="@Url.Action("Index", "VisitorPipeline")" class="flex items-center space-x-2 px-2 py-1.5 rounded-md text-[11px] font-medium hover:bg-white/10 transition text-gray-200">
                                    <i class="fa-solid fa-person-walking-arrow-right w-3.5 text-center text-amber-400 shrink-0"></i>
                                    <span>Ruta del Visitante</span>
                                </a>
                                <a href="@Url.Action("Index", "Bulletins")" class="flex items-center space-x-2 px-2 py-1.5 rounded-md text-[11px] font-medium hover:bg-white/10 transition text-gray-200">
                                    <i class="fa-solid fa-bullhorn w-3.5 text-center text-emerald-400 shrink-0"></i>
                                    <span>Boletines y Avisos</span>
                                </a>
                            </div>
                        </div>
                    }

                    <!-- HERRAMIENTAS FINANCIERAS -->
                    <div class="py-0.5">
                        <button @@click="toolsOpen = !toolsOpen" class="w-full flex items-center justify-between px-2.5 py-2 rounded-lg font-medium hover:bg-white/10 transition text-left">
                            <div class="flex items-center space-x-2.5">
                                <i class="fa-solid fa-toolbox w-5 text-center text-[#00A8CC] text-sm shrink-0"></i>
                                <span class="transition-opacity" :class="{ 'md:hidden': !desktopOpen }">Herramientas</span>
                            </div>
                            <i class="fa-solid fa-chevron-down text-[10px] transition-transform duration-200" :class="{ 'rotate-180': toolsOpen, 'md:hidden': !desktopOpen }"></i>
                        </button>

                        <div x-show="toolsOpen" class="pl-3 pr-1 py-0.5 space-y-0.5 border-l border-[#00A8CC]/40 ml-4 my-0.5" :class="{ 'md:hidden': !desktopOpen }">
                            <a href="@Url.Action("Index", "FinancialTools")" class="flex items-center space-x-2 px-2 py-1.5 rounded-md text-[11px] font-medium hover:bg-white/10 transition text-gray-200">
                                <i class="fa-solid fa-border-all w-3.5 text-center text-[#00A8CC] shrink-0"></i>
                                <span>Hub General</span>
                            </a>
                            <a href="@Url.Action("Index", "Budget")" class="flex items-center space-x-2 px-2 py-1.5 rounded-md text-[11px] font-medium hover:bg-white/10 transition text-gray-200">
                                <i class="fa-solid fa-calculator w-3.5 text-center text-emerald-400 shrink-0"></i>
                                <span>Presupuesto Mensual</span>
                            </a>
                            <a href="@Url.Action("Index", "FinancialStatement")" class="flex items-center space-x-2 px-2 py-1.5 rounded-md text-[11px] font-medium hover:bg-white/10 transition text-gray-200">
                                <i class="fa-solid fa-scale-balanced w-3.5 text-center text-cyan-400 shrink-0"></i>
                                <span>Estado Financiero</span>
                            </a>
                            <a href="@Url.Action("Index", "DebtSnowball")" class="flex items-center space-x-2 px-2 py-1.5 rounded-md text-[11px] font-medium hover:bg-white/10 transition text-gray-200">
                                <i class="fa-solid fa-snowflake w-3.5 text-center text-sky-400 shrink-0"></i>
                                <span>Bola de Nieve</span>
                            </a>
                        </div>
                    </div>
                }
            </nav>
        </div>

        <!-- Botón colapsar escritorio -->
        <div class="p-2 border-t border-white/10 shrink-0 hidden md:block">
            <button @@click="desktopOpen = !desktopOpen" class="w-full flex items-center justify-center space-x-1.5 px-2 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white transition text-[11px] font-semibold">
                <i class="fa-solid" :class="desktopOpen ? 'fa-angles-left' : 'fa-angles-right'"></i>
                <span x-show="desktopOpen" class="transition-opacity">Colapsar</span>
            </button>
        </div>
    </aside>

    <!-- 3. CONTENEDOR PRINCIPAL -->
    <div id="app" class="min-h-full flex flex-col flex-grow w-full min-w-0 overflow-y-auto">

        <!-- Header Superior -->
        <header class="bg-[#1B365D] text-white shadow-md sticky top-0 z-30 shrink-0">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-14">

                    <div class="flex items-center space-x-3">
                        <button @@click="mobileOpen = !mobileOpen" class="p-2 rounded-lg bg-white/10 text-white hover:bg-white/20 transition focus:outline-none md:hidden" title="Abrir Menú">
                            <i class="fa-solid fa-bars text-sm"></i>
                        </button>
                        <span class="font-extrabold text-sm md:text-base text-white tracking-wide truncate">Panel de Gestión</span>
                    </div>

                    <!-- Acciones Derecha -->
                    <div class="flex items-center space-x-2 sm:space-x-3 shrink-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <button type="button" onclick="openJoinChurchModal()" class="px-2.5 py-1.5 rounded-lg bg-[#00A8CC]/20 hover:bg-[#00A8CC]/30 text-[#00A8CC] transition-all text-xs font-bold flex items-center space-x-1" title="Vincularme a mi iglesia">
                                <i class="fa-solid fa-church text-xs"></i>
                                <span class="hidden md:inline">Unirme a Iglesia</span>
                            </button>

                            <div class="text-right hidden sm:block leading-tight">
                                <div class="text-xs font-bold truncate max-w-[140px]">@User.Identity.Name</div>
                                <div class="text-[9px] text-[#00A8CC] uppercase tracking-wider font-semibold">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                            </div>

                            <a href="@Url.Action("Index", "Home")" class="p-2 rounded-lg bg-gray-700/60 hover:bg-gray-700 text-white transition-all shadow" title="Ir al Landing Page">
                                <i class="fa-solid fa-house text-xs"></i>
                            </a>

                            <button type="button" onclick="openChangePasswordModal()" class="p-2 rounded-lg bg-gray-700/60 hover:bg-gray-700 text-white transition-all shadow" title="Cambiar mi contraseña">
                                <i class="fa-solid fa-key text-xs"></i>
                            </button>

                            <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" title="Cerrar Sesión" class="p-2 rounded-lg bg-red-600/80 hover:bg-red-600 text-white transition-all shadow">
                                    <i class="fa-solid fa-right-from-bracket text-xs"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a href="@Url.Action("Login", "Account")" class="px-2.5 py-1.5 text-xs font-semibold text-white hover:text-[#00A8CC] transition-all">
                                Iniciar Sesión
                            </a>
                            <a href="@Url.Action("Login", "Account")#register" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-[#00A8CC] text-white hover:bg-[#0090B0] transition-all shadow">
                                Registrarse
                            </a>
                        }
                    </div>

                </div>
            </div>
        </header>

        <!-- Contenido -->
        <main id="main-content-area" class="flex-grow max-w-7xl w-full mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6">
            @RenderBody()
        </main>
    </div>

    <!-- Modal Cambio de Contraseña -->
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div id="changePasswordModal" class="fixed inset-0 z-50 hidden bg-black bg-opacity-50 flex items-center justify-center p-4">
            <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-6">
                <div class="flex justify-between items-center mb-4 pb-2 border-b border-gray-100">
                    <h3 class="text-xl font-bold text-[#1B365D] flex items-center">
                        <i class="fa-solid fa-key mr-2 text-[#00A8CC]"></i> Cambiar Mi Contraseña
                    </h3>
                    <button type="button" onclick="closeChangePasswordModal()" class="text-gray-400 hover:text-gray-600"><i class="fa-solid fa-xmark text-lg"></i></button>
                </div>
                <form onsubmit="submitUserChangePassword(event)" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Contraseña Actual</label>
                        <input type="password" id="current-password" required placeholder="••••••••" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Nueva Contraseña</label>
                        <input type="password" id="new-password" required placeholder="••••••••" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Confirmar Nueva Contraseña</label>
                        <input type="password" id="confirm-password" required placeholder="••••••••" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                    </div>
                    <div class="flex justify-end space-x-3 pt-4 border-t border-gray-100">
                        <button type="button" onclick="closeChangePasswordModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-semibold">Cancelar</button>
                        <button type="submit" class="px-5 py-2 bg-[#1B365D] text-white rounded-lg text-sm font-semibold">Actualizar Contraseña</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Modal Vinculación a Iglesia -->
        <div id="joinChurchModal" class="fixed inset-0 z-50 hidden bg-black bg-opacity-50 flex items-center justify-center p-4">
            <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-6 text-gray-800">
                <div class="flex justify-between items-center mb-3 pb-2 border-b border-gray-100">
                    <h3 class="text-base font-bold text-[#1B365D] flex items-center">
                        <i class="fa-solid fa-church text-[#00A8CC] mr-2"></i> Unirme a mi Iglesia
                    </h3>
                    <button type="button" onclick="closeJoinChurchModal()" class="text-gray-400 hover:text-gray-600"><i class="fa-solid fa-xmark text-lg"></i></button>
                </div>
                <p class="text-xs text-gray-500 mb-4">Ingresa el código proporcionado por tu iglesia para desbloquear funciones avanzadas y conectar tus donaciones.</p>
                <form onsubmit="submitJoinChurchCode(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Código de Invitación</label>
                        <input type="text" id="church-invite-code" required placeholder="Ej: CENTRAL2026" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm uppercase font-mono tracking-wider focus:ring-2 focus:ring-[#1B365D]">
                    </div>
                    <div class="flex justify-end space-x-2 pt-2">
                        <button type="button" onclick="closeJoinChurchModal()" class="px-3 py-2 bg-gray-100 text-gray-700 rounded-lg text-xs font-semibold">Cancelar</button>
                        <button type="submit" class="px-4 py-2 bg-[#1B365D] text-white rounded-lg text-xs font-bold hover:bg-[#00A8CC] transition">Vincularme</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Toast y Funciones JS -->
    <script>
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgColor = type === 'success' ? 'bg-green-600' : type === 'error' ? 'bg-red-600' : 'bg-[#1B365D]';
            toast.className = `${bgColor} text-white px-5 py-3 rounded-lg shadow-lg flex items-center justify-between space-x-3 transition-all transform translate-y-2 opacity-0`;
            toast.innerHTML = `
                <div class="flex items-center space-x-2">
                    <i class="fa-solid ${type === 'success' ? 'fa-circle-check' : type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-info'}"></i>
                    <span class="text-sm font-medium">${message}</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-white hover:text-gray-200"><i class="fa-solid fa-xmark"></i></button>
            `;
            container.appendChild(toast);
            setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
            setTimeout(() => {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        function openChangePasswordModal() {
            document.getElementById('changePasswordModal').classList.remove('hidden');
        }

        function closeChangePasswordModal() {
            document.getElementById('changePasswordModal').classList.add('hidden');
        }

        function openJoinChurchModal() {
            document.getElementById('joinChurchModal').classList.remove('hidden');
        }

        function closeJoinChurchModal() {
            document.getElementById('joinChurchModal').classList.add('hidden');
        }

        async function submitJoinChurchCode(e) {
            e.preventDefault();
            const code = document.getElementById('church-invite-code').value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const response = await fetch('/Church/JoinByCode', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ code: code })
                });

                const res = await response.json();
                if (res.success) {
                    showToast(res.message, 'success');
                    closeJoinChurchModal();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showToast(res.message, 'error');
                }
            } catch (err) {
                showToast('Error de conexión.', 'error');
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
