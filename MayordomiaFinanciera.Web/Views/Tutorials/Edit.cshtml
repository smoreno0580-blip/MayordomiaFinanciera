@model MayordomiaFinanciera.Web.Models.Tutorials.PlatformTutorialDto
@{
    ViewData["Title"] = Model.Id == Guid.Empty ? "Nuevo Tutorial" : "Editar Tutorial";
    Layout = "_Layout";
}

<div class="max-w-3xl mx-auto py-6 px-4 space-y-6">
    <div class="bg-white p-6 rounded-3xl shadow-md border border-gray-200">
        <h1 class="text-xl font-black text-[#1B365D]">@(Model.Id == Guid.Empty ? "Crear Nuevo Tutorial" : "Editar Tutorial")</h1>

        <form asp-action="Edit" method="post" class="space-y-4 text-xs mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block font-bold text-gray-700 uppercase mb-1">Título</label>
                    <input asp-for="Title" required class="w-full px-3.5 py-2.5 border rounded-xl" />
                </div>
                <div>
                    <label class="block font-bold text-gray-700 uppercase mb-1">Categoría</label>
                    <input asp-for="Category" required placeholder="Ej: Pastores, Miembros, Finanzas" class="w-full px-3.5 py-2.5 border rounded-xl" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block font-bold text-gray-700 uppercase mb-1">URL de YouTube (Opcional)</label>
                    <input asp-for="YoutubeUrl" placeholder="https://www.youtube.com/watch?v=..." class="w-full px-3.5 py-2.5 border rounded-xl" />
                </div>
                <div>
                    <label class="block font-bold text-gray-700 uppercase mb-1">Icono FontAwesome</label>
                    <input asp-for="IconClass" placeholder="fa-solid fa-book-open" class="w-full px-3.5 py-2.5 border rounded-xl" />
                </div>
            </div>

            <div>
                <label class="block font-bold text-gray-700 uppercase mb-1">Descripción Corta</label>
                <textarea asp-for="Description" rows="2" class="w-full px-3.5 py-2.5 border rounded-xl"></textarea>
            </div>

            <div>
                <label class="block font-bold text-gray-700 uppercase mb-1">Contenido Paso a Paso (HTML soportado)</label>
                <textarea asp-for="StepByStepContent" rows="6" class="w-full px-3.5 py-2.5 border rounded-xl font-mono"></textarea>
            </div>

            <div class="flex justify-between items-center pt-4">
                <a asp-action="AdminIndex" class="text-gray-500 hover:underline">Cancelar</a>
                <button type="submit" class="px-6 py-3 bg-[#1B365D] text-white font-bold rounded-xl hover:bg-[#00A8CC] transition">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>