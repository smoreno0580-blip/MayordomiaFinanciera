@model IEnumerable<MayordomiaFinanciera.Web.Models.Tutorials.PlatformTutorialDto>
@{
    ViewData["Title"] = "Centro de Ayuda y Tutoriales";
    Layout = "_Layout";
}

<div class="max-w-6xl mx-auto space-y-8 py-6 px-4">
    <!-- Encabezado -->
    <div class="bg-gradient-to-r from-[#1B365D] to-[#00A8CC] rounded-3xl p-8 text-white shadow-xl text-center space-y-3">
        <span class="px-3 py-1 bg-white/20 rounded-full text-[10px] font-black uppercase tracking-widest text-sky-100">Centro de Capacitación</span>
        <h1 class="text-3xl font-black">Guía del Usuario y Tutoriales</h1>
        <p class="text-xs text-sky-100 max-w-xl mx-auto">Encuentra respuestas rápidas, guías paso a paso y videotutoriales para aprovechar al máximo la plataforma.</p>
    </div>

    <!-- Cuadrícula de Tutoriales -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        @foreach (var tutorial in Model)
        {
            <div class="bg-white p-6 rounded-3xl shadow-md border border-gray-200 flex flex-col justify-between space-y-4 hover:shadow-lg transition">
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-2xl bg-sky-50 text-[#00A8CC] flex items-center justify-center text-xl font-bold">
                        <i class="@tutorial.IconClass"></i>
                    </div>
                    <div>
                        <span class="text-[10px] font-black uppercase text-amber-500 tracking-wider">@tutorial.Category</span>
                        <h3 class="font-black text-base text-[#1B365D]">@tutorial.Title</h3>
                    </div>
                    <p class="text-xs text-gray-600 leading-relaxed">@tutorial.Description</p>
                </div>
                <div>
                    <a asp-action="Details" asp-route-id="@tutorial.Id" class="w-full py-2.5 bg-gray-50 hover:bg-sky-50 text-[#1B365D] hover:text-[#00A8CC] font-bold text-xs rounded-xl border border-gray-200 transition flex items-center justify-center space-x-2">
                        <span>Ver Guía Completa</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>