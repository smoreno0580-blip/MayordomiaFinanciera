@model IEnumerable<MayordomiaFinanciera.Web.Models.Tutorials.PlatformTutorialDto>
@{
    ViewData["Title"] = "Administrar Tutoriales";
    Layout = "_Layout";
}

<div class="max-w-6xl mx-auto space-y-6 py-6 px-4">
    <div class="flex justify-between items-center bg-white p-6 rounded-3xl shadow-md border border-gray-200">
        <div>
            <span class="text-xs font-bold text-[#00A8CC] uppercase">Gestión de Contenido</span>
            <h1 class="text-2xl font-black text-[#1B365D]">Centro de Ayuda y Tutoriales</h1>
        </div>
        <a asp-action="Edit" class="px-5 py-2.5 bg-[#1B365D] hover:bg-[#00A8CC] text-white text-xs font-bold rounded-xl transition shadow flex items-center space-x-2">
            <i class="fa-solid fa-plus"></i>
            <span>Nuevo Tutorial</span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-50 border-l-4 border-emerald-500 p-4 rounded-xl text-emerald-800 text-xs">
            <i class="fa-solid fa-circle-check mr-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="bg-white rounded-3xl shadow-md border border-gray-200 overflow-hidden">
        <table class="w-full text-left text-xs text-gray-600">
            <thead class="bg-gray-50 text-[#1B365D] uppercase font-black border-b">
                <tr>
                    <th class="p-4">Orden</th>
                    <th class="p-4">Título</th>
                    <th class="p-4">Categoría</th>
                    <th class="p-4">Video</th>
                    <th class="p-4 text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var t in Model)
                {
                    <tr class="hover:bg-gray-50/50">
                        <td class="p-4 font-bold">@t.DisplayOrder</td>
                        <td class="p-4 font-bold text-[#1B365D]">@t.Title</td>
                        <td class="p-4"><span class="px-2.5 py-1 bg-amber-50 text-amber-600 rounded-full font-bold text-[10px]">@t.Category</span></td>
                        <td class="p-4">
                            @if (!string.IsNullOrWhiteSpace(t.YoutubeUrl))
                            {
                                <i class="fa-brands fa-youtube text-red-500 text-base"></i>
                            }
                            else
                            {
                                <span class="text-gray-300">—</span>
                            }
                        </td>
                        <td class="p-4 text-right space-x-2">
                            <a asp-action="Edit" asp-route-id="@t.Id" class="text-sky-600 hover:text-sky-800 font-bold p-1"><i class="fa-solid fa-pen-to-square"></i></a>
                            <form asp-action="Delete" method="post" class="inline" onsubmit="return confirm('¿Deseas eliminar este tutorial?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="text-red-500 hover:text-red-700 font-bold p-1"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>