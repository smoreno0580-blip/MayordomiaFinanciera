                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200 flex items-start space-x-4">
                        <div class="w-12 h-12 bg-blue-50 text-[#00A8CC] rounded-xl flex items-center justify-center text-xl shrink-0">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-[#1B365D] text-base">Ubicación</h4>
                            <p class="text-xs text-gray-500 mt-1">La Chorrera, Panamá Oeste, República de Panamá</p>
                        </div>
                    </div>
                </div>

                <!-- Formulario de Mensaje -->
                <div class="lg:col-span-2 bg-white p-8 rounded-2xl shadow-sm border border-gray-200">
                    <h3 class="text-xl font-bold text-[#1B365D] mb-6">Envíanos un Mensaje Directo</h3>

                    <!-- Alertas temporales de éxito o error -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="mb-4 p-4 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm">
                            @TempData["Success"]
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="mb-4 p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm">
                            @TempData["Error"]
                        </div>
                    }

                    <form asp-controller="Home" asp-action="SendContactMessage" method="post" class="space-y-4">
                        @Html.AntiForgeryToken()
                        <!-- CAMPO HONEYPOT (Trampa para Bots - Oculto vía CSS) -->
                        <div style="display:none;" aria-hidden="true">
                            <input type="text" name="website_hp" tabindex="-1" autocomplete="off" />
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Nombre Completo</label>
                                <input type="text" name="name" required placeholder="Tu nombre" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Correo Electrónico</label>
                                <input type="email" name="email" required placeholder="tu@correo.com" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Asunto</label>
                            <input type="text" name="subject" required placeholder="Ej. Información sobre grupos para mi iglesia" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Mensaje</label>
                            <textarea name="message" rows="4" required placeholder="Escribe tu consulta aquí..." class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#1B365D] focus:outline-none"></textarea>
                        </div>
                        <div class="text-right">
                            <button type="submit" class="px-6 py-3 bg-[#1B365D] text-white font-bold text-sm rounded-xl hover:bg-opacity-90 transition shadow">
                                <i class="fa-solid fa-paper-plane mr-2"></i> Enviar Consulta
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Llamado a la Acción / Ingreso -->
    <section class="py-20 bg-[#1B365D] text-white text-center">
        <div class="max-w-4xl mx-auto px-4">
            <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">¿Listo para comenzar tu camino a la libertad financiera?</h2>
            <p class="text-gray-300 mb-8">Únete a nuestros grupos de estudio y accede a tus sesiones, material y videoconferencias en un solo lugar.</p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="@Url.Action("Login", "Account")" class="px-8 py-4 rounded-xl text-base font-bold bg-[#00A8CC] text-white hover:bg-white hover:text-[#1B365D] transition-all shadow-lg">
                    Iniciar Sesión en el Aplicativo
                </a>
            </div>
        </div>
    </section>

    <!-- Pie de Página -->
    <footer class="bg-gray-900 text-gray-400 py-8 border-t border-gray-800 text-xs text-center">
        <p>&copy; @DateTime.Now.Year Mayordomía y Finanzas - Todos los derechos reservados.</p>
    </footer>

</body>
</html>