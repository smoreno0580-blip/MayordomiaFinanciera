@{
    Layout = null; // No utiliza el layout del aplicativo interno para mantener un diseño independiente
}

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mayordomía y Finanzas - Finanzas Bíblicas</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">

    <!-- 1. Navegación Superior Limpia y Organizada -->
    <header class="fixed w-full bg-[#1B365D] text-white shadow-lg z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">

            <!-- Logo -->
            <a href="#hero" class="flex items-center space-x-3 shrink-0">
                <div class="w-10 h-10 bg-[#00A8CC] rounded-lg flex items-center justify-center shadow">
                    <i class="fa-solid fa-scale-balanced text-[#1B365D] font-bold text-xl"></i>
                </div>
                <div class="leading-tight">
                    <span class="font-bold text-lg sm:text-xl tracking-wide block text-white">Finanzas Bíblicas</span>
                    <span class="text-[9px] text-[#00A8CC] uppercase tracking-widest font-semibold block">Mayordomía y Finanzas</span>
                </div>
            </a>

            <!-- Menú Central -->
            <nav class="hidden xl:flex items-center space-x-6 text-sm font-medium text-gray-200">
                <a href="#quienes-somos" class="hover:text-[#00A8CC] transition">Quiénes Somos</a>
                <a href="#pilares" class="hover:text-[#00A8CC] transition">Pilares</a>
                <a href="#programas" class="hover:text-[#00A8CC] transition">Programas</a>
                <a href="#planes-iglesias" class="hover:text-[#00A8CC] transition">Planes Iglesias</a>
                <a href="#contacto" class="hover:text-[#00A8CC] transition">Contacto</a>
                <a href="@Url.Action("Index", "Donations")" class="text-[#00A8CC] font-bold hover:underline flex items-center space-x-1">
                    <i class="fa-solid fa-heart mr-1"></i><span>Donar</span>
                </a>
            </nav>

            <!-- Acciones Principales Derecha -->
            <div class="flex items-center space-x-2 sm:space-x-3 shrink-0">
                <a href="@Url.Action("Login", "Account")" class="px-3 py-2 text-xs sm:text-sm font-semibold text-gray-200 hover:text-[#00A8CC] transition">
                    Iniciar Sesión
                </a>

                <a href="@Url.Action("Login", "Account")#register" class="px-3.5 py-2 rounded-lg text-xs font-bold bg-white/10 hover:bg-white/20 text-white transition border border-white/20">
                    Registro Personal
                </a>

                <a href="#planes-iglesias" class="px-4 py-2 rounded-lg text-xs font-extrabold bg-[#00A8CC] text-white hover:bg-[#0090B0] transition shadow-md flex items-center space-x-1.5">
                    <i class="fa-solid fa-church"></i>
                    <span>Registrar Iglesia</span>
                </a>
            </div>

        </div>
    </header>

    <!-- 2. Sección Hero -->
    <section id="hero" class="pt-32 pb-20 bg-gradient-to-br from-[#1B365D] via-[#234373] to-[#12243e] text-white relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col lg:flex-row items-center justify-between gap-12">
            <div class="lg:w-1/2 space-y-6 text-center lg:text-left">
                <span class="bg-[#00A8CC]/20 text-[#00A8CC] border border-[#00A8CC]/40 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider inline-block">
                    Ministerio Cristocéntrico & Plataforma SaaS
                </span>
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight">
                    Transforma tus Finanzas con Principios Bíblicos
                </h1>
                <p class="text-gray-300 text-base sm:text-lg max-w-xl mx-auto lg:mx-0">
                    Capacitamos e inspiramos a personas, familias e iglesias a administrar el dinero y los recursos materiales bajo el diseño y propósito divino.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
                    <a href="@Url.Action("Login", "Account")" class="w-full sm:w-auto px-8 py-3.5 rounded-xl text-sm font-bold bg-[#00A8CC] text-white hover:bg-white hover:text-[#1B365D] transition-all shadow-xl text-center">
                        Ingresar a la Plataforma <i class="fa-solid fa-arrow-right ml-2"></i>
                    </a>
                    <a href="#planes-iglesias" class="w-full sm:w-auto px-8 py-3.5 rounded-xl text-sm font-bold border border-white/30 hover:bg-white/10 transition-all text-center flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-church"></i>
                        <span>Ver Planes para Iglesias</span>
                    </a>
                </div>
            </div>

            <div class="lg:w-1/2 flex justify-center">
                <div class="relative w-full max-w-md bg-white/10 backdrop-blur-md p-8 rounded-2xl border border-white/20 shadow-2xl">
                    <div class="text-center space-y-4">
                        <div class="w-16 h-16 bg-[#00A8CC] rounded-2xl flex items-center justify-center mx-auto shadow-lg">
                            <i class="fa-solid fa-book-bible text-white text-3xl"></i>
                        </div>
                        <h3 class="text-2xl font-bold">Estudios e Impacto</h3>
                        <p class="text-sm text-gray-300">
                            "Del Señor es la tierra y todo lo que hay en ella, el mundo y los que en él habitan." — Salmo 24:1
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Sección Quiénes Somos -->
    <section id="quienes-somos" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl font-extrabold text-[#1B365D]">¿Quiénes Somos?</h2>
                <div class="w-20 h-1 bg-[#00A8CC] mx-auto my-4 rounded-full"></div>
                <p class="text-gray-600">
                    Somos un ministerio enfocado en la enseñanza práctica y espiritual de la mayordomía financiera, proveyendo herramientas para salir de deudas, ahorrar y generar generosidad radical.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <div class="space-y-6">
                    <div class="flex items-start space-x-4">
                        <div class="p-3 bg-cyan-50 text-[#00A8CC] rounded-xl font-bold text-xl"><i class="fa-solid fa-bullseye"></i></div>
                        <div>
                            <h3 class="text-lg font-bold text-[#1B365D]">Nuestra Misión</h3>
                            <p class="text-gray-600 text-sm mt-1">Formar discípulos en el área financiera para que vivan en libertad, paz y abundancia con un corazón enfocado en la gran comisión.</p>
                        </div>
                    </div>
                    <div class="flex items-start space-x-4">
                        <div class="p-3 bg-sky-50 text-[#00A8CC] rounded-xl font-bold text-xl"><i class="fa-solid fa-eye"></i></div>
                        <div>
                            <h3 class="text-lg font-bold text-[#1B365D]">Nuestra Visión</h3>
                            <p class="text-gray-600 text-sm mt-1">Ver miles de familias libres de deudas, restauradas financieramente e impactando sus comunidades locales mediante la generosidad.</p>
                        </div>
                    </div>
                </div>
                <div class="bg-gray-100 p-8 rounded-2xl border border-gray-200">
                    <h4 class="font-bold text-[#1B365D] text-xl mb-4">Lo que enseñamos</h4>
                    <ul class="space-y-3 text-sm text-gray-700">
                        <li class="flex items-center"><i class="fa-solid fa-check text-[#00A8CC] mr-3"></i> Dios es el dueño de todo; somos administradores.</li>
                        <li class="flex items-center"><i class="fa-solid fa-check text-[#00A8CC] mr-3"></i> Cómo elaborar presupuestos bíblicos aplicables.</li>
                        <li class="flex items-center"><i class="fa-solid fa-check text-[#00A8CC] mr-3"></i> Estrategias efectivas para salir de deudas.</li>
                        <li class="flex items-center"><i class="fa-solid fa-check text-[#00A8CC] mr-3"></i> La cultura del ahorro, inversión y la herencia de bendición.</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. Sección Pilares -->
    <section id="pilares" class="py-20 bg-gray-50 border-y border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl font-extrabold text-[#1B365D]">Nuestros Pilares</h2>
                <div class="w-20 h-1 bg-[#00A8CC] mx-auto my-4 rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 text-center space-y-4">
                    <div class="w-14 h-14 bg-cyan-50 text-[#00A8CC] rounded-2xl flex items-center justify-center text-2xl mx-auto">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <h3 class="text-xl font-bold text-[#1B365D]">Educación Práctica</h3>
                    <p class="text-gray-600 text-sm">Cursos estructurados por niveles y sesiones diseñadas para la implementación semanal.</p>
                </div>

                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 text-center space-y-4">
                    <div class="w-14 h-14 bg-sky-50 text-[#00A8CC] rounded-2xl flex items-center justify-center text-2xl mx-auto">
                        <i class="fa-solid fa-people-group"></i>
                    </div>
                    <h3 class="text-xl font-bold text-[#1B365D]">Grupos de Discipulado</h3>
                    <p class="text-gray-600 text-sm">Acompañamiento en grupos reducidos liderados por facilitadores y profesores capacitados.</p>
                </div>

                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 text-center space-y-4">
                    <div class="w-14 h-14 bg-blue-50 text-[#00A8CC] rounded-2xl flex items-center justify-center text-2xl mx-auto">
                        <i class="fa-solid fa-hand-holding-heart"></i>
                    </div>
                    <h3 class="text-xl font-bold text-[#1B365D]">Comunidad y Muro</h3>
                    <p class="text-gray-600 text-sm">Espacio donde los miembros comparten testimonios, peticiones de oración y victorias financieras.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. Sección Programas Educativos Personales -->
    <section id="programas" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl font-extrabold text-[#1B365D]">Programas para Personas</h2>
                <div class="w-20 h-1 bg-[#00A8CC] mx-auto my-4 rounded-full"></div>
                <p class="text-gray-600">
                    Diseñados para acompañarte en cada etapa de tu aprendizaje financiero integral.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Programa 1 -->
                <div class="bg-gray-50 rounded-2xl p-8 border border-gray-200 flex flex-col justify-between hover:shadow-lg transition">
                    <div>
                        <div class="text-xs font-bold uppercase tracking-wider text-[#00A8CC] bg-cyan-50 inline-block px-3 py-1 rounded-full mb-4">
                            Duración • 10 Semanas
                        </div>
                        <h3 class="text-2xl font-bold text-[#1B365D] mb-3">Construye tus finanzas a la manera de Dios</h3>
                        <p class="text-gray-600 text-sm mb-6">Estudio de discipulado financiero en donde aprendemos la perspectiva bíblica del dinero.</p>
                    </div>
                    <a href="@Url.Action("Login", "Account")#register" class="block text-center w-full py-3 bg-[#1B365D] text-white font-bold text-sm rounded-xl hover:bg-opacity-90 transition">Inscribirme</a>
                </div>

                <!-- Programa 2 -->
                <div class="bg-gray-50 rounded-2xl p-8 border border-[#00A8CC]/40 relative flex flex-col justify-between shadow-md hover:shadow-xl transition">
                    <span class="absolute -top-3 right-6 bg-[#00A8CC] text-white text-[10px] uppercase font-bold px-3 py-1 rounded-full shadow">Más Popular</span>
                    <div>
                        <div class="text-xs font-bold uppercase tracking-wider text-[#00A8CC] bg-cyan-50 inline-block px-3 py-1 rounded-full mb-4">
                            Duración • 6 Semanas
                        </div>
                        <h3 class="text-2xl font-bold text-[#1B365D] mb-3">¿Cómo llego a fin de mes?</h3>
                        <p class="text-gray-600 text-sm mb-6">Aprende cómo estirar tu salario para convertirlo en el instrumento de tus metas.</p>
                    </div>
                    <a href="@Url.Action("Login", "Account")#register" class="block text-center w-full py-3 bg-[#00A8CC] text-white font-bold text-sm rounded-xl hover:bg-[#0090B0] transition">Inscribirme</a>
                </div>

                <!-- Programa 3 -->
                <div class="bg-gray-50 rounded-2xl p-8 border border-gray-200 flex flex-col justify-between hover:shadow-lg transition">
                    <div>
                        <div class="text-xs font-bold uppercase tracking-wider text-[#00A8CC] bg-cyan-50 inline-block px-3 py-1 rounded-full mb-4">
                            Duración • 10 Semanas
                        </div>
                        <h3 class="text-2xl font-bold text-[#1B365D] mb-3">Discipulado financiero para jóvenes</h3>
                        <p class="text-gray-600 text-sm mb-6">Principios financieros aplicados para jóvenes con una perspectiva bíblica.</p>
                    </div>
                    <a href="@Url.Action("Login", "Account")#register" class="block text-center w-full py-3 bg-[#1B365D] text-white font-bold text-sm rounded-xl hover:bg-opacity-90 transition">Inscribirme</a>
                </div>
            </div>
        </div>
    </section>

    <!-- 6. SECCIÓN DE PLANES Y REGISTRO DE IGLESIAS (Unificado: 4 Planes) -->
    <section id="planes-iglesias" class="py-20 bg-gray-50 border-t border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-xs font-extrabold uppercase text-[#00A8CC] tracking-widest bg-cyan-50 px-3 py-1 rounded-full">
                    Solución B2B para Iglesias y Ministerios
                </span>
                <h2 class="text-3xl font-extrabold text-[#1B365D] mt-3">Planes de Suscripción Ministerial</h2>
                <div class="w-20 h-1 bg-[#00A8CC] mx-auto my-4 rounded-full"></div>
                <p class="text-gray-600">
                    Selecciona el plan ideal para tu congregación o inicia tu prueba de 30 días sin costo alguno.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

                <!-- Plan Demo (Gratis 30 Días) -->
                <div class="bg-white p-6 rounded-3xl border-2 border-emerald-500 shadow-lg relative flex flex-col justify-between hover:shadow-xl transition">
                    <span class="absolute -top-3.5 right-6 bg-emerald-500 text-white text-[10px] font-extrabold uppercase px-3 py-1 rounded-full shadow">
                        Prueba Gratis
                    </span>
                    <div>
                        <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider block">Plan Demo</span>
                        <h3 class="text-3xl font-black text-[#1B365D] mt-2">$0 <span class="text-xs font-normal text-gray-500">/ 30 días</span></h3>
                        <p class="text-xs text-gray-500 mt-2">Prueba todas las funciones sin tarjeta de crédito ni compromiso.</p>
                        <ul class="text-xs text-gray-600 space-y-2.5 mt-6">
                            <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-2"></i> Hasta 20 miembros incluidos</li>
                            <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-2"></i> Acceso a todas las funciones</li>
                            <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-2"></i> Código de invitación activo</li>
                            <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-2"></i> Formaliza tu pago cuando desees</li>
                        </ul>
                    </div>
                    <div class="mt-8">
                        <a href="@Url.Action("Checkout", "ChurchPublic", new { plan = "DEMO_30" })"
                           class="block w-full text-center py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs rounded-xl transition shadow">
                            Probar Gratis 30 Días
                        </a>
                    </div>
                </div>

                <!-- Plan Semilla -->
                <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm hover:shadow-xl transition flex flex-col justify-between">
                    <div>
                        <span class="text-xs font-bold text-[#00A8CC] uppercase tracking-wider block">Plan Semilla</span>
                        <h3 class="text-3xl font-black text-[#1B365D] mt-2">$25 <span class="text-xs font-normal text-gray-500">/ mes</span></h3>
                        <p class="text-xs text-gray-500 mt-2">Ideal para iglesias pequeñas o misiones emergentes.</p>
                        <ul class="text-xs text-gray-600 space-y-2.5 mt-6">
                            <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-2"></i> Hasta 50 miembros incluidos</li>
                            <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-2"></i> Herramientas completas</li>
                            <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-2"></i> Código de invitación único</li>
                        </ul>
                    </div>
                    <div class="mt-8">
                        <a href="@Url.Action("Checkout", "ChurchPublic", new { plan = "SEED" })"
                           class="block w-full text-center py-3 px-4 bg-[#1B365D] hover:bg-[#00A8CC] text-white font-bold text-xs rounded-xl transition shadow">
                            Registrar ($25/mes)
                        </a>
                    </div>
                </div>

                <!-- Plan Ministerial - Recomendado -->
                <div class="bg-white p-6 rounded-3xl border-2 border-[#00A8CC] shadow-xl relative flex flex-col justify-between transform lg:-translate-y-2">
                    <span class="absolute -top-3.5 right-6 bg-[#00A8CC] text-white text-[10px] font-extrabold uppercase px-3 py-1 rounded-full shadow">
                        Recomendado
                    </span>
                    <div>
                        <span class="text-xs font-bold text-[#00A8CC] uppercase tracking-wider block">Plan Ministerial</span>
                        <h3 class="text-3xl font-black text-[#1B365D] mt-2">$50 <span class="text-xs font-normal text-gray-500">/ mes</span></h3>
                        <p class="text-xs text-gray-500 mt-2">Para congregaciones medianas en crecimiento.</p>
                        <ul class="text-xs text-gray-600 space-y-2.5 mt-6">
                            <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-2"></i> Hasta 200 miembros incluidos</li>
                            <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-2"></i> Reportes ejecutivos consolidados</li>
                            <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-2"></i> Módulos pastorales avanzados</li>
                        </ul>
                    </div>
                    <div class="mt-8">
                        <a href="@Url.Action("Checkout", "ChurchPublic", new { plan = "MINISTERIAL" })"
                           class="block w-full text-center py-3 px-4 bg-[#00A8CC] hover:bg-[#0090B0] text-white font-black text-xs rounded-xl transition shadow-lg">
                            Registrar ($50/mes)
                        </a>
                    </div>
                </div>

                <!-- Plan Catedral -->
                <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm hover:shadow-xl transition flex flex-col justify-between">
                    <div>
                        <span class="text-xs font-bold text-[#00A8CC] uppercase tracking-wider block">Plan Catedral</span>
                        <h3 class="text-3xl font-black text-[#1B365D] mt-2">$100 <span class="text-xs font-normal text-gray-500">/ mes</span></h3>
                        <p class="text-xs text-gray-500 mt-2">Para megaiglesias o múltiples sedes.</p>
                        <ul class="text-xs text-gray-600 space-y-2.5 mt-6">
                            <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-2"></i> Hasta 1,000 miembros incluidos</li>
                            <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-2"></i> Múltiples administradores</li>
                            <li class="flex items-center"><i class="fa-solid fa-check text-emerald-500 mr-2"></i> Soporte prioritario</li>
                        </ul>
                    </div>
                    <div class="mt-8">
                        <a href="@Url.Action("Checkout", "ChurchPublic", new { plan = "CATHEDRAL" })"
                           class="block w-full text-center py-3 px-4 bg-[#1B365D] hover:bg-[#00A8CC] text-white font-bold text-xs rounded-xl transition shadow">
                            Registrar ($100/mes)
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 7. Sección Contacto -->
    <section id="contacto" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl font-extrabold text-[#1B365D]">Contáctenos</h2>
                <div class="w-20 h-1 bg-[#00A8CC] mx-auto my-4 rounded-full"></div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="space-y-6">
                    <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200 flex items-start space-x-4">
                        <div class="w-12 h-12 bg-cyan-50 text-[#00A8CC] rounded-xl flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-envelope"></i></div>
                        <div>
                            <h4 class="font-bold text-[#1B365D]">Correo Electrónico</h4>
                            <a href="mailto:panama@compassfinancialministry.org" class="text-xs font-semibold text-[#00A8CC] hover:underline block mt-1">panama@compassfinancialministry.org</a>
                        </div>
                    </div>

                    <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200 flex items-start space-x-4">
                        <div class="w-12 h-12 bg-sky-50 text-[#00A8CC] rounded-xl flex items-center justify-center text-xl shrink-0"><i class="fa-solid fa-phone"></i></div>
                        <div>
                            <h4 class="font-bold text-[#1B365D]">Teléfono</h4>
                            <a href="tel:+50762132831" class="text-xs font-semibold text-[#1B365D] block mt-1">+507 6213-2831</a>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-2 bg-gray-50 p-8 rounded-2xl border border-gray-200">
                    <h3 class="text-xl font-bold text-[#1B365D] mb-6">Envíanos un Mensaje</h3>
                    <form asp-controller="Home" asp-action="SendContactMessage" method="post" class="space-y-4">
                        @Html.AntiForgeryToken()
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Nombre Completo</label>
                                <input type="text" name="name" required class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Correo Electrónico</label>
                                <input type="email" name="email" required class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Mensaje</label>
                            <textarea name="message" rows="4" required class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm"></textarea>
                        </div>
                        <button type="submit" class="px-6 py-2.5 bg-[#1B365D] text-white font-bold text-sm rounded-xl hover:bg-opacity-90 transition shadow">
                            Enviar Consulta
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Pie de Página -->
    <footer class="bg-gray-900 text-gray-400 py-8 text-xs text-center border-t border-gray-800">
        <p>&copy; @DateTime.Now.Year Mayordomía y Finanzas - Todos los derechos reservados.</p>
    </footer>

</body>
</html>