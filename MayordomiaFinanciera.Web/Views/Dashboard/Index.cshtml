@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Panel Principal - Dashboard";
    Layout = "_Layout";

    int totalUsers = ViewBag.TotalUsers ?? 0;
    int totalGroups = ViewBag.TotalGroups ?? 0;
    int totalSessions = ViewBag.TotalSessions ?? 0;
    int birthdaysCount = ViewBag.BirthdaysCount ?? 0;
    DataTable recentPosts = ViewBag.RecentPosts as DataTable ?? new DataTable();
    DataTable churchBulletins = ViewBag.ChurchBulletins as DataTable ?? new DataTable();
    DataTable upcomingEvents = ViewBag.UpcomingEvents as DataTable ?? new DataTable();
    bool isStudent = User.IsInRole("student") || User.IsInRole("MIEMBRO") || User.IsInRole("miembro");

    // Obtener el rol eclesial específico de la base de datos y claims
    string churchRole = ViewBag.ChurchRole as string ?? "";
    string userRoleClaim = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.ToUpper() ?? "";

    // Validar si el usuario en sesión es Pastor Principal o Administrador de la congregación
    bool isMainPastorOrAdmin = churchRole.Contains("PASTOR") ||
                               churchRole.Contains("ADMIN") ||
                               userRoleClaim.Contains("PASTOR") ||
                               userRoleClaim.Contains("ADMIN") ||
                               User.IsInRole("admin") ||
                               User.IsInRole("ADMIN") ||
                               User.IsInRole("pastor") ||
                               User.IsInRole("PASTOR");

    string churchName = ViewBag.ChurchName as string ?? "";

    // Datos de suscripción y periodo de gracia enviados desde el controlador
    string subscriptionStatus = ViewBag.SubscriptionStatus as string ?? "ACTIVE";
    DateTime? nextBillingDate = ViewBag.NextBillingDate as DateTime?;

    bool isPastDue = nextBillingDate.HasValue && DateTime.Now > nextBillingDate.Value;
    int daysInGrace = isPastDue && nextBillingDate.HasValue ? (int)(DateTime.Now - nextBillingDate.Value).TotalDays : 0;
    bool isInGracePeriod = isPastDue && daysInGrace <= 7;
}

<!-- Banner / Encabezado Principal del Dashboard -->
<div class="mb-8 bg-gradient-to-r from-[#1B365D] via-[#162d4e] to-[#00A8CC] p-6 md:p-8 rounded-2xl text-white shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div>
        <div class="flex items-center space-x-2 mb-2">
            <span class="text-xs uppercase tracking-wider font-semibold opacity-80">Bienvenido de nuevo</span>
            @if (!string.IsNullOrEmpty(churchName))
            {
                <span class="inline-flex items-center space-x-1.5 bg-white/20 backdrop-blur-md px-3 py-0.5 rounded-full text-xs font-bold text-white border border-white/20">
                    <i class="fa-solid fa-church text-amber-300"></i>
                    <span>@churchName</span>
                </span>
            }
        </div>
        <h1 class="text-2xl md:text-3xl font-black">Panel de Control</h1>
        <p class="text-xs md:text-sm text-blue-100 mt-1">Resumen general y métricas operativas de Mayordomía y Finanzas.</p>
    </div>

    @if (!string.IsNullOrEmpty(churchName))
    {
        <div class="hidden md:flex items-center space-x-3 bg-white/10 backdrop-blur-sm px-4 py-3 rounded-xl border border-white/10 shrink-0">
            <div class="w-10 h-10 rounded-lg bg-amber-400/20 flex items-center justify-center text-amber-300 text-lg font-black">
                <i class="fa-solid fa-place-of-worship"></i>
            </div>
            <div>
                <span class="block text-[10px] uppercase font-bold text-blue-200">Iglesia / Ministerio</span>
                <span class="text-xs font-bold text-white">@churchName</span>
            </div>
        </div>
    }
</div>

<!-- Tarjetas KPI Dinámicas -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Tarjeta 1: Usuarios -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 flex items-center justify-between">
        <div>
            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Total Usuarios</p>
            <h3 class="text-3xl font-extrabold text-[#1B365D] mt-1">@totalUsers</h3>
        </div>
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-[#1B365D] flex items-center justify-center text-xl">
            <i class="fa-solid fa-users"></i>
        </div>
    </div>

    <!-- Tarjeta 2: Grupos -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 flex items-center justify-between">
        <div>
            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Grupos Activos</p>
            <h3 class="text-3xl font-extrabold text-[#1B365D] mt-1">@totalGroups</h3>
        </div>
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-[#00A8CC] flex items-center justify-center text-xl">
            <i class="fa-solid fa-people-group"></i>
        </div>
    </div>

    <!-- Tarjeta 3: Sesiones -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 flex items-center justify-between">
        <div>
            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Sesiones Programadas</p>
            <h3 class="text-3xl font-extrabold text-[#1B365D] mt-1">@totalSessions</h3>
        </div>
        <div class="w-12 h-12 rounded-xl bg-green-50 text-green-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-calendar-check"></i>
        </div>
    </div>

    <!-- Tarjeta 4: Cumpleaños del Mes -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 flex items-center justify-between">
        <div>
            <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Cumpleaños del Mes</p>
            <h3 class="text-3xl font-extrabold text-[#00A8CC] mt-1">@birthdaysCount</h3>
        </div>
        <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-cake-candles"></i>
        </div>
    </div>
</div>

<!-- SECCIÓN: Estado de la Suscripción Ministerial (Visible solo para el Pastor Principal o Administrador) -->
@if (isMainPastorOrAdmin)
{
    <div class="mb-8 p-6 rounded-xl shadow-sm border flex flex-col md:flex-row items-start md:items-center justify-between gap-4 @(isInGracePeriod ? "bg-amber-50 border-amber-200" : "bg-white border-gray-200")">
        <div class="flex items-center space-x-4">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center text-xl shrink-0 @(isInGracePeriod ? "bg-amber-100 text-amber-600" : "bg-emerald-50 text-emerald-600")">
                <i class="fa-solid @(isInGracePeriod ? "fa-triangle-exclamation" : "fa-shield-halved")"></i>
            </div>
            <div>
                <h3 class="text-sm font-bold text-[#1B365D]">Estado de la Suscripción Ministerial</h3>
                <p class="text-xs text-gray-500">
                    @if (isInGracePeriod)
                    {
                        <span class="text-amber-700 font-semibold">Tu suscripción ha llegado a su fecha de corte. Estás en período de gracia (Día @daysInGrace de 7). Realiza tu pago para evitar el bloqueo.</span>
                    }
                    else
                    {
                        <span>Monitorea la vigencia de tu cuenta y los pagos mensuales de soporte de la congregación.</span>
                    }
                </p>
            </div>
        </div>

        <div class="flex items-center space-x-3 w-full md:w-auto justify-end">
            @if (isInGracePeriod)
            {
                <span class="px-3 py-1 bg-amber-100 text-amber-800 font-bold text-xs rounded-lg border border-amber-200 flex items-center">
                    <i class="fa-solid fa-clock mr-1.5 text-amber-600"></i> Gracia Activa (Quedan @(7 - daysInGrace) días)
                </span>
            }
            else
            {
                <span class="px-3 py-1 bg-emerald-50 text-emerald-700 font-bold text-xs rounded-lg border border-emerald-100 flex items-center">
                    <i class="fa-solid fa-circle-check mr-1.5 text-emerald-600"></i> Al Día (Activa)
                </span>
            }
            <a href="@Url.Action("PendingPayment", "Subscription")" class="px-3.5 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-lg transition">
                Ver Detalles de Pago
            </a>
        </div>
    </div>
}

<!-- SECCIÓN: Agenda Ministerial & Próximos Eventos -->
<div class="mb-8 bg-white p-6 rounded-xl shadow-sm border border-gray-200 space-y-4">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-3 border-b border-gray-100">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-2xl bg-[#00A8CC]/10 text-[#00A8CC] flex items-center justify-center font-bold text-lg">
                <i class="fa-solid fa-calendar-days"></i>
            </div>
            <div>
                <span class="text-[10px] font-black uppercase tracking-widest text-[#00A8CC]">Agenda Eclesial</span>
                <h2 class="text-base font-black text-[#1B365D]">Próximos Eventos & Cultos</h2>
            </div>
        </div>

        <!-- ⚙️ Botón de Mantenimiento del Calendario -->
        <a href="@Url.Action("Index", "Calendar")"
           class="px-3.5 py-2 bg-gray-50 hover:bg-[#1B365D] text-[#1B365D] hover:text-white font-bold text-xs rounded-xl border border-gray-200 transition flex items-center space-x-2 shadow-sm">
            <i class="fa-solid fa-gear text-xs"></i>
            <span>Administrar Calendario</span>
        </a>
    </div>

    <!-- Lista de Eventos Agendados -->
    <div class="space-y-3 pt-1">
        @if (upcomingEvents.Rows.Count > 0)
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (DataRow row in upcomingEvents.Rows)
                {
                    var startDate = Convert.ToDateTime(row["start_date"]);
                    bool isVirtual = row["is_virtual"] != DBNull.Value && Convert.ToBoolean(row["is_virtual"]);

                    <div class="flex items-center justify-between p-3.5 bg-gray-50/80 hover:bg-gray-50 rounded-2xl border border-gray-100 transition">
                        <div class="flex items-center space-x-3.5 min-w-0">
                            <div class="w-11 h-11 rounded-2xl bg-[#1B365D] text-white flex flex-col items-center justify-center font-black shrink-0">
                                <span class="text-[9px] uppercase tracking-wider text-sky-300">@startDate.ToString("MMM", new System.Globalization.CultureInfo("es-ES"))</span>
                                <span class="text-sm font-black leading-none">@startDate.Day</span>
                            </div>
                            <div class="min-w-0">
                                <div class="flex items-center space-x-2">
                                    <span class="px-2 py-0.5 bg-sky-50 text-[#00A8CC] font-bold text-[9px] rounded-md uppercase">
                                        @row["category"]
                                    </span>
                                    @if (isVirtual)
                                    {
                                        <span class="text-[10px] text-indigo-600 font-bold flex items-center gap-1">
                                            <i class="fa-solid fa-video"></i> Online
                                        </span>
                                    }
                                </div>
                                <h4 class="text-xs font-bold text-[#1B365D] truncate mt-0.5">@row["title"]</h4>
                                <p class="text-[11px] text-gray-500 flex items-center space-x-2 mt-0.5">
                                    <span><i class="fa-solid fa-clock text-gray-400 mr-1"></i>@startDate.ToString("hh:mm tt")</span>
                                    @if (row["location"] != DBNull.Value && !string.IsNullOrWhiteSpace(row["location"].ToString()))
                                    {
                                        <span class="truncate"><i class="fa-solid fa-location-dot text-red-400 mr-1"></i>@row["location"]</span>
                                    }
                                </p>
                            </div>
                        </div>
                        <a href="@Url.Action("Index", "Calendar")" class="text-gray-400 hover:text-[#00A8CC] text-xs p-2 shrink-0">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-6 bg-gray-50/50 rounded-2xl border border-dashed border-gray-200 space-y-2">
                <i class="fa-solid fa-calendar-check text-gray-300 text-2xl"></i>
                <p class="text-xs text-gray-500 font-medium">No hay eventos próximos en la agenda.</p>
                <a href="@Url.Action("Index", "Calendar")" class="text-xs font-bold text-[#00A8CC] hover:underline inline-block">
                    + Programar un nuevo evento
                </a>
            </div>
        }
    </div>
</div>

<!-- SECCIÓN: Boletines y Avisos Oficiales para la Congregación -->
<div class="mb-8 bg-white p-6 rounded-xl shadow-sm border border-gray-200">
    <div class="flex items-center justify-between mb-4 pb-2 border-b border-gray-100">
        <h3 class="font-bold text-[#1B365D] text-base flex items-center">
            <i class="fa-solid fa-bullhorn text-[#00A8CC] mr-2"></i> Avisos y Boletines Oficiales
        </h3>
        <a href="@Url.Action("Index", "Bulletins")" class="text-xs font-bold text-[#00A8CC] hover:underline">
            Ver todos <i class="fa-solid fa-arrow-right ml-1"></i>
        </a>
    </div>

    @if (churchBulletins.Rows.Count == 0)
    {
        <div class="text-center py-6 text-gray-400 text-xs">
            <i class="fa-regular fa-newspaper text-2xl mb-2 block text-gray-300"></i>
            No hay avisos o boletines publicados en este momento.
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (DataRow bRow in churchBulletins.Rows)
            {
                <div class="bg-gray-50 p-4 rounded-xl border border-gray-100 flex flex-col justify-between space-y-2 hover:shadow-sm transition">
                    <div>
                        <span class="text-[10px] font-bold text-[#00A8CC] bg-blue-50 px-2 py-0.5 rounded-md inline-block mb-1">
                            <i class="fa-solid fa-calendar-day mr-1"></i> @(bRow["publish_date"] != DBNull.Value ? Convert.ToDateTime(bRow["publish_date"]).ToString("dd/MM/yyyy") : "Reciente")
                        </span>
                        <h4 class="text-sm font-bold text-[#1B365D]">@bRow["title"]</h4>
                        <p class="text-xs text-gray-600 line-clamp-2 mt-1 leading-relaxed">@bRow["content"]</p>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Sección Inferior: Accesos Rápidos y Actividad Reciente -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Columna Izquierda: Accesos Directos -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 lg:col-span-1">
        <h3 class="font-bold text-[#1B365D] text-base mb-4 flex items-center"><i class="fa-solid fa-compass text-[#00A8CC] mr-2"></i> Accesos Rápidos</h3>
        <div class="space-y-3">
            <!-- Acceso Directo al Calendario Ministerial -->
            <a href="@Url.Action("Index", "Calendar")" class="flex items-center justify-between p-3 rounded-lg bg-gray-50 hover:bg-gray-100 transition-all text-sm font-semibold text-gray-700">
                <span><i class="fa-solid fa-calendar-days mr-2 text-[#00A8CC]"></i> Agenda / Calendario</span>
                <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>
            </a>

            @if (!isStudent)
            {
                <a href="@Url.Action("Index", "Groups")" class="flex items-center justify-between p-3 rounded-lg bg-gray-50 hover:bg-gray-100 transition-all text-sm font-semibold text-gray-700">
                    <span><i class="fa-solid fa-people-roof mr-2 text-[#1B365D]"></i> Gestionar Grupos</span>
                    <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>
                </a>
            }
            <a href="@Url.Action("Index", "Sessions")" class="flex items-center justify-between p-3 rounded-lg bg-gray-50 hover:bg-gray-100 transition-all text-sm font-semibold text-gray-700">
                <span><i class="fa-solid fa-video mr-2 text-[#1B365D]"></i> Ver Sesiones y Zoom</span>
                <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>
            </a>
            <a href="@Url.Action("Index", "Birthdays")" class="flex items-center justify-between p-3 rounded-lg bg-gray-50 hover:bg-gray-100 transition-all text-sm font-semibold text-gray-700">
                <span><i class="fa-solid fa-cake-candles mr-2 text-[#1B365D]"></i> Agenda de Cumpleaños</span>
                <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>
            </a>
            <a href="@Url.Action("Index", "Community")" class="flex items-center justify-between p-3 rounded-lg bg-gray-50 hover:bg-gray-100 transition-all text-sm font-semibold text-gray-700">
                <span><i class="fa-solid fa-comments mr-2 text-[#1B365D]"></i> Muro de Comunidad</span>
                <i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>
            </a>
        </div>
    </div>

    <!-- Columna Derecha: Actividad Reciente del Muro -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 lg:col-span-2">
        <h3 class="font-bold text-[#1B365D] text-base mb-4 flex items-center"><i class="fa-solid fa-bolt text-[#00A8CC] mr-2"></i> Actividad Reciente en Comunidad</h3>
        <div class="space-y-3">
            @if (recentPosts.Rows.Count == 0)
            {
                <p class="text-sm text-gray-500 py-6 text-center">No hay actividad reciente registrada en el muro.</p>
            }
            else
            {
                int limit = 0;
                foreach (DataRow pRow in recentPosts.Rows)
                {
                    if (limit >= 3) break;
                    <div class="p-4 rounded-lg bg-gray-50 border border-gray-100">
                        <div class="flex justify-between items-center mb-1">
                            <span class="font-bold text-xs text-[#1B365D]">@(pRow.Table.Columns.Contains("Name") && pRow["Name"] != DBNull.Value ? pRow["Name"] : (pRow.Table.Columns.Contains("name") && pRow["name"] != DBNull.Value ? pRow["name"] : "Usuario"))</span>
                            <span class="text-[11px] text-gray-400">@(pRow.Table.Columns.Contains("CreatedAt") && pRow["CreatedAt"] != DBNull.Value ? Convert.ToDateTime(pRow["CreatedAt"]).ToString("dd/MM/yyyy HH:mm") : (pRow.Table.Columns.Contains("created_at") && pRow["created_at"] != DBNull.Value ? Convert.ToDateTime(pRow["created_at"]).ToString("dd/MM/yyyy HH:mm") : ""))</span>
                        </div>
                        <p class="text-xs text-gray-600 line-clamp-2">@(pRow.Table.Columns.Contains("Content") && pRow["Content"] != DBNull.Value ? pRow["Content"] : (pRow.Table.Columns.Contains("content") && pRow["content"] != DBNull.Value ? pRow["content"] : ""))</p>
                    </div>
                    limit++;
                }
            }
        </div>
    </div>
</div>