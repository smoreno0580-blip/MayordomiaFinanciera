@model System.Data.DataTable

@{
    ViewData["Title"] = "Configurar Donaciones de la Iglesia";
    var row = Model.Rows.Count > 0 ? Model.Rows[0] : null;
}

<div class="max-w-3xl mx-auto mt-8 p-8 bg-white rounded-2xl shadow-xl border border-gray-100 space-y-6">
    <div class="border-b pb-4">
        <h1 class="text-2xl font-black text-[#1B365D]">Configuración de Donaciones y Cuentas</h1>
        <p class="text-xs text-gray-500 mt-1">
            Actualiza la información bancaria y métodos de pago oficiales para los miembros de tu congregación.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-50 border-l-4 border-emerald-500 p-4 text-xs text-emerald-800 rounded-r-xl">
            @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="SaveDonationSettings" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Nombre del Banco</label>
                <input type="text" name="bankName" value="@(row?["bank_name"]?.ToString() ?? "")" required
                       class="w-full px-4 py-2 text-xs border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Tipo de Cuenta</label>
                <input type="text" name="accountType" value="@(row?["account_type"]?.ToString() ?? "Corriente")" required
                       class="w-full px-4 py-2 text-xs border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" />
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Número de Cuenta</label>
                <input type="text" name="accountNumber" value="@(row?["account_number"]?.ToString() ?? "")" required
                       class="w-full px-4 py-2 text-xs border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Titular de la Cuenta</label>
                <input type="text" name="accountHolder" value="@(row?["account_holder"]?.ToString() ?? "")" required
                       class="w-full px-4 py-2 text-xs border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" />
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Número de Yappy / Pago Móvil (Opcional)</label>
            <input type="text" name="yappyNumber" value="@(row?["yappy_number"]?.ToString() ?? "")"
                   class="w-full px-4 py-2 text-xs border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" />
        </div>

        <div>
            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Instrucciones Adicionales</label>
            <textarea name="additionalInstructions" rows="3"
                      class="w-full px-4 py-2 text-xs border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#00A8CC] focus:outline-none">@(row?["additional_instructions"]?.ToString() ?? "")</textarea>
        </div>

        <div class="pt-4 flex justify-end">
            <button type="submit" class="px-6 py-3 bg-[#00A8CC] hover:bg-[#008fa8] text-white font-bold text-xs rounded-xl shadow transition">
                Guardar Cambios
            </button>
        </div>
    </form>
</div>