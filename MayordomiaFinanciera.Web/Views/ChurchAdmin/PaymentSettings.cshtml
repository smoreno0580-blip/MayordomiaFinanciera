@model MayordomiaFinanciera.Web.Models.Church.ChurchPaymentSettingsDto

@{
    ViewData["Title"] = "Configuración de Pagos y Donaciones";
    Layout = "_Layout";
}

<div class="max-w-3xl mx-auto px-4 py-12">
    <div class="bg-white p-8 rounded-2xl shadow-xl border border-gray-100 space-y-6">
        <div class="border-b pb-4">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center text-amber-600 text-xl font-bold shadow-inner">
                    <i class="fa-solid fa-church"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-black text-[#1B365D]">Cuentas de Donación de la Congregación</h1>
                    <p class="text-xs text-gray-500 mt-0.5">
                        Personaliza los canales oficiales (ACH, Yappy y PayPal) donde los miembros de tu iglesia realizarán sus aportes.
                    </p>
                </div>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-emerald-50 border-l-4 border-emerald-500 p-4 text-xs text-emerald-800 rounded-r-xl shadow-sm">
                @TempData["SuccessMessage"]
            </div>
        }

        <form asp-action="PaymentSettings" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ChurchId" />

            <!-- SECCIÓN ACH / TRANSFERENCIA -->
            <div class="bg-gray-50 p-5 rounded-xl border border-gray-200 space-y-4">
                <div class="flex items-center justify-between border-b pb-2">
                    <h2 class="text-sm font-bold text-[#1B365D] uppercase tracking-wider">
                        <i class="fa-solid fa-building-columns mr-1.5 text-blue-600"></i> Transferencia Bancaria (ACH)
                    </h2>
                    <label class="flex items-center space-x-2 cursor-pointer text-xs font-semibold text-gray-700">
                        <input asp-for="IsAchEnabled" type="checkbox" class="rounded border-gray-300 text-[#00A8CC] focus:ring-[#00A8CC]" />
                        <span>Habilitar ACH</span>
                    </label>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Nombre del Banco</label>
                        <input asp-for="AchBankName" type="text" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Tipo de Cuenta</label>
                        <input asp-for="AchAccountType" type="text" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Número de Cuenta</label>
                        <input asp-for="AchAccountNumber" type="text" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none font-mono" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Titular de la Cuenta</label>
                        <input asp-for="AchAccountHolder" type="text" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" />
                    </div>
                </div>
            </div>

            <!-- SECCIÓN YAPPY -->
            <div class="bg-gray-50 p-5 rounded-xl border border-gray-200 space-y-4">
                <div class="flex items-center justify-between border-b pb-2">
                    <h2 class="text-sm font-bold text-[#1B365D] uppercase tracking-wider">
                        <i class="fa-solid fa-mobile-screen-button mr-1.5 text-amber-500"></i> Yappy
                    </h2>
                    <label class="flex items-center space-x-2 cursor-pointer text-xs font-semibold text-gray-700">
                        <input asp-for="IsYappyEnabled" type="checkbox" class="rounded border-gray-300 text-[#00A8CC] focus:ring-[#00A8CC]" />
                        <span>Habilitar Yappy</span>
                    </label>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Número de Teléfono</label>
                        <input asp-for="YappyPhone" type="text" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none font-mono" placeholder="Ej. 6000-0000" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Alias o Nombre en Yappy</label>
                        <input asp-for="YappyAlias" type="text" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" placeholder="Ej. MiIglesia" />
                    </div>
                </div>
            </div>

            <!-- SECCIÓN PAYPAL -->
            <div class="bg-gray-50 p-5 rounded-xl border border-gray-200 space-y-4">
                <div class="flex items-center justify-between border-b pb-2">
                    <h2 class="text-sm font-bold text-[#1B365D] uppercase tracking-wider">
                        <i class="fa-brands fa-paypal mr-1.5 text-sky-600"></i> PayPal
                    </h2>
                    <label class="flex items-center space-x-2 cursor-pointer text-xs font-semibold text-gray-700">
                        <input asp-for="IsPaypalEnabled" type="checkbox" class="rounded border-gray-300 text-[#00A8CC] focus:ring-[#00A8CC]" />
                        <span>Habilitar PayPal</span>
                    </label>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Correo Electrónico de PayPal o Enlace</label>
                    <input asp-for="PaypalEmail" type="text" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl bg-white focus:ring-2 focus:ring-[#00A8CC] focus:outline-none" placeholder="Ej. tesoreria@iglesia.com" />
                </div>
            </div>

            <!-- BOTONES DE ACCIÓN -->
            <div class="pt-4 flex items-center justify-between border-t">
                <a href="@Url.Action("Index", "ChurchAdmin")" class="text-xs font-bold text-gray-500 hover:text-gray-700">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Volver a Información Eclesial
                </a>
                <button type="submit" class="px-6 py-3 bg-[#00A8CC] hover:bg-[#008fa8] text-white font-bold text-xs rounded-xl shadow transition">
                    Guardar Configuración
                </button>
            </div>
        </form>
    </div>
</div>